---
// SearchBox.astro - 全局搜索框组件
---

<div class="search-box mb-6" id="search-box">
  <div class="relative">
    <input 
      type="text" 
      id="search-input"
      placeholder="搜索文章、工具、视频..."
      class="w-full px-4 py-2.5 pl-10 bg-white border border-gray-300 rounded-sm text-sm font-body
             focus:border-ochre focus:ring-1 focus:ring-ochre focus:outline-none
             transition-colors placeholder:text-gray-400"
    />
    <!-- 搜索图标 -->
    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
    <!-- 清除按钮 -->
    <button 
      id="search-clear" 
      class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 text-lg leading-none"
      title="清除搜索"
    >×</button>
  </div>
  
  <!-- 搜索状态 -->
  <div id="search-status" class="hidden mt-2 text-xs text-gray-500 italic"></div>
</div>

<script>
import Fuse from 'fuse.js';

// 搜索控制器
class SearchController {
  private fuse: Fuse<HTMLElement> | null = null;
  private allItems: HTMLElement[] = [];
  private searchInput: HTMLInputElement | null = null;
  private clearBtn: HTMLElement | null = null;
  private statusEl: HTMLElement | null = null;
  private debounceTimer: number | null = null;
  
  constructor() {
    this.init();
  }
  
  init() {
    this.searchInput = document.getElementById('search-input') as HTMLInputElement;
    this.clearBtn = document.getElementById('search-clear');
    this.statusEl = document.getElementById('search-status');
    
    if (!this.searchInput) return;
    
    // 获取所有可搜索项
    this.allItems = Array.from(document.querySelectorAll('[data-tags]')) as HTMLElement[];
    
    // 构建搜索索引
    this.buildIndex();
    
    // 从 URL 恢复搜索状态
    const params = new URLSearchParams(window.location.search);
    const query = params.get('q');
    if (query) {
      this.searchInput.value = query;
      this.search(query);
    }
    
    // 绑定事件
    this.searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value;
      this.debounceSearch(query);
    });
    
    this.clearBtn?.addEventListener('click', () => this.clear());
    
    // 按 Escape 清除
    this.searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') this.clear();
    });
  }
  
  buildIndex() {
    // 为每个内容项提取可搜索文本
    const searchableItems = this.allItems.map((item, index) => {
      // 获取标题
      const titleEl = item.querySelector('h2, h3');
      const title = titleEl?.textContent?.trim() || '';
      
      // 获取描述
      const descEl = item.querySelector('.drop-cap, p');
      const description = descEl?.textContent?.trim() || '';
      
      // 获取标签
      const tags = item.getAttribute('data-tags') || '';
      
      // 获取分类
      const categoryEl = item.querySelector('.text-ochre');
      const category = categoryEl?.textContent?.trim() || '';
      
      return {
        index,
        element: item,
        title,
        description,
        tags,
        category
      };
    });
    
    // 创建 Fuse 实例
    this.fuse = new Fuse(searchableItems, {
      keys: [
        { name: 'title', weight: 2 },
        { name: 'description', weight: 1 },
        { name: 'tags', weight: 1.5 },
        { name: 'category', weight: 1 }
      ],
      threshold: 0.4, // 模糊匹配阈值
      includeScore: true,
      ignoreLocation: true
    });
  }
  
  debounceSearch(query: string) {
    if (this.debounceTimer) {
      clearTimeout(this.debounceTimer);
    }
    this.debounceTimer = window.setTimeout(() => {
      this.search(query);
    }, 300);
  }
  
  search(query: string) {
    const trimmedQuery = query.trim();
    
    // 更新清除按钮显示
    if (this.clearBtn) {
      this.clearBtn.classList.toggle('hidden', !trimmedQuery);
    }
    
    if (!trimmedQuery) {
      // 无搜索词，显示所有
      this.showAll();
      this.syncUrl('');
      return;
    }
    
    if (!this.fuse) return;
    
    // 执行搜索
    const results = this.fuse.search(trimmedQuery);
    const matchedIndices = new Set(results.map(r => (r.item as any).index));
    
    let visibleCount = 0;
    this.allItems.forEach((item, index) => {
      const matches = matchedIndices.has(index);
      item.style.display = matches ? '' : 'none';
      if (matches) visibleCount++;
      
      // 处理分隔符
      const nextSibling = item.nextElementSibling as HTMLElement;
      if (nextSibling?.tagName === 'HR') {
        nextSibling.style.display = matches ? '' : 'none';
      }
    });
    
    // 更新状态
    if (this.statusEl) {
      this.statusEl.textContent = `找到 ${visibleCount} 个结果`;
      this.statusEl.classList.remove('hidden');
    }
    
    // 同步 URL
    this.syncUrl(trimmedQuery);
    
    // 触发自定义事件，通知 TagFilter
    window.dispatchEvent(new CustomEvent('search-changed', { 
      detail: { query: trimmedQuery, matchedIndices } 
    }));
  }
  
  showAll() {
    this.allItems.forEach(item => {
      item.style.display = '';
      const nextSibling = item.nextElementSibling as HTMLElement;
      if (nextSibling?.tagName === 'HR') {
        nextSibling.style.display = '';
      }
    });
    
    if (this.statusEl) {
      this.statusEl.classList.add('hidden');
    }
    
    // 触发自定义事件
    window.dispatchEvent(new CustomEvent('search-changed', { 
      detail: { query: '', matchedIndices: null } 
    }));
  }
  
  clear() {
    if (this.searchInput) {
      this.searchInput.value = '';
    }
    this.showAll();
    this.syncUrl('');
    this.searchInput?.focus();
  }
  
  syncUrl(query: string) {
    const url = new URL(window.location.href);
    if (query) {
      url.searchParams.set('q', query);
    } else {
      url.searchParams.delete('q');
    }
    window.history.replaceState({}, '', url.toString());
  }
}

// 初始化
function initSearch() {
  new SearchController();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initSearch);
} else {
  initSearch();
}

// Astro View Transitions 支持
document.addEventListener('astro:page-load', initSearch);
</script>

<style>
  #search-input:focus + svg {
    color: #8a6240; /* ochre */
  }
</style>
