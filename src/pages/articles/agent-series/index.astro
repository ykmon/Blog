---
// agent-series/index.astro - Agent 系列索引页
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import SeriesChapters from '../../../components/SeriesChapters.astro';

const articles = [
  {
    href: 'agent-introduction',
    title: '第一章：Agent的入门',
    desc: '从 LLM、上下文与工具出发，理解 Agent 的基本组成、ReAct 循环、Harness 工程与安全护栏。',
  },
  {
    href: 'agent-tools',
    title: '第二章：工具',
    desc: '五类工具的划分与设计原则、工具描述的艺术，以及 MCP 与 Skill Hub 下的工具组织、按需加载与安全边界。',
  },
  {
    href: 'agent-mcp',
    title: '第三章：MCP 与 Function Calling',
    desc: 'Function Calling、AI Agent 与 MCP 各自解决什么问题，MCP 的 Host、Client、Server 如何协作，以及何时该用 MCP、何时该用 Skill。',
  },
];
---

<ArticleLayout
  title="Agent 系列"
  category="Agent"
  categoryLink="/series/"
  showToc={false}
  description="从 Agent 的基本组成开始，逐步理解模型、上下文、工具、编排与可靠性工程。"
>
  <p class="mb-10 text-gray-600">Agent 系列从一个清晰的起点开始：Agent 是如何观察环境、调用工具并持续完成任务的？后续章节将沿着模型、上下文、工具和 Harness 工程继续展开。</p>
  <SeriesChapters basePath="/articles/agent-series" articles={articles} />
</ArticleLayout>
