---
// ArticleCard.astro - 文章卡片组件
import { formatDateCN } from '../utils/date';

export interface Props {
  href: string;
  title: string;
  category: string;
  tags?: string[];
  description: string;
  date: string;
  readTime?: string;
  image?: string;
  imageAlt?: string;
  placeholder?: string; // 如果没有图片，显示的占位文字
}

const { href, title, category, tags = [], description, date } = Astro.props;
---

<article class="reading-list-item" data-tags={tags.join(',')}>
  <div class="reading-list-title">
    <h2><a href={href}>{title}</a></h2>
    <time datetime={date}>{formatDateCN(date, true)}</time>
  </div>
  <p data-filter-description>{description}</p>
  <span class="sr-only" data-filter-category>{category}</span>
</article>
