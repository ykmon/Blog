---
import SearchBox from './SearchBox.astro';
import { navItems } from '../data/navigation';
---

<div
  id="mobile-nav-overlay"
  class="fixed inset-0 z-40 bg-black/45 opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
></div>

<aside
  id="mobile-nav-drawer"
  class="fixed right-0 top-0 z-50 h-full w-80 max-w-[86vw] translate-x-full overflow-y-auto border-l border-ink/10 bg-paper shadow-2xl transition-transform duration-300 ease-out"
  aria-label="移动端导航菜单"
  aria-hidden="true"
>
  <div class="space-y-6 p-6">
    <div class="flex items-center justify-between border-b border-ink/10 pb-4">
      <h2 class="font-serif text-xl text-ink">Menu</h2>
      <button
        id="mobile-nav-close"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-ink/10 bg-white text-gray-500 transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ochre/70"
        aria-label="关闭导航菜单"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="rounded-[1.5rem] border border-ink/10 bg-white/70 p-4 text-center">
      <div class="mx-auto h-16 w-16 overflow-hidden rounded-full border border-ink/10">
        <img loading="lazy" decoding="async" src="/Resource/ykmon.jpg" alt="YKMON" class="h-full w-full object-cover" width="64" height="64" />
      </div>
      <h3 class="mt-3 font-serif text-xl font-bold text-ink">YKMON</h3>
      <p class="mt-1 text-[11px] uppercase tracking-[0.28em] text-ochre">Technical Artist</p>
      <p class="mt-3 text-sm leading-6 text-gray-600">致力自动化管线开发，非传统技术美术，从项目管理到技术落地。</p>
    </div>

    <SearchBox />

    <nav class="space-y-2" aria-label="移动端主导航">
      <div class="mb-2 flex items-center justify-between border-b border-ink/10 pb-3">
        <h4 class="font-serif text-lg italic text-ink">Sections</h4>
        <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400">Navigation</span>
      </div>

      {navItems.map((item) => (
        <a
          href={item.href}
          class="group flex items-center justify-between rounded-2xl border border-transparent px-3 py-3 text-ink transition-all duration-300 hover:border-ochre/15 hover:bg-white hover:text-ochre"
        >
          <span class="flex items-center gap-2">
            <span class="text-[10px] font-bold tracking-[0.32em] text-gray-400 group-hover:text-ochre">{item.num}</span>
            <span class="text-base">{item.label}</span>
          </span>
          <span class="text-[10px] uppercase tracking-[0.25em] text-gray-400 group-hover:text-ochre">{item.labelEn}</span>
        </a>
      ))}
    </nav>
  </div>
</aside>

<script>
  let mobileNavAbort: AbortController | null = null;

  function initMobileNav() {
    if (mobileNavAbort) {
      mobileNavAbort.abort();
    }
    mobileNavAbort = new AbortController();
    const { signal } = mobileNavAbort;

    const toggle = document.getElementById('mobile-nav-toggle');
    const overlay = document.getElementById('mobile-nav-overlay');
    const drawer = document.getElementById('mobile-nav-drawer');
    const closeBtn = document.getElementById('mobile-nav-close');
    const menuIcon = document.getElementById('mobile-nav-menu-icon');
    const closeIcon = document.getElementById('mobile-nav-close-icon');

    if (!toggle || !overlay || !drawer || !closeBtn) return;

    let isOpen = false;

    const openDrawer = () => {
      isOpen = true;
      drawer.classList.remove('translate-x-full');
      drawer.classList.add('translate-x-0');
      drawer.setAttribute('aria-hidden', 'false');
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100', 'pointer-events-auto');
      toggle.setAttribute('aria-expanded', 'true');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      document.body.classList.add('drawer-open');
    };

    const closeDrawer = () => {
      isOpen = false;
      drawer.classList.add('translate-x-full');
      drawer.classList.remove('translate-x-0');
      drawer.setAttribute('aria-hidden', 'true');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      toggle.setAttribute('aria-expanded', 'false');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.classList.remove('drawer-open');
    };

    toggle.addEventListener(
      'click',
      () => {
        if (isOpen) {
          closeDrawer();
        } else {
          openDrawer();
        }
      },
      { signal }
    );
    closeBtn.addEventListener('click', closeDrawer, { signal });
    overlay.addEventListener('click', closeDrawer, { signal });

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && isOpen) {
          closeDrawer();
        }
      },
      { signal }
    );

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener(
        'click',
        () => {
          window.setTimeout(closeDrawer, 140);
        },
        { signal }
      );
    });

    window.addEventListener(
      'resize',
      () => {
        if (window.innerWidth >= 1024 && isOpen) {
          closeDrawer();
        }
      },
      { signal }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileNav);
  } else {
    initMobileNav();
  }

  const globalWindow = window as Window & { __mobileNavBound?: boolean };
  if (!globalWindow.__mobileNavBound) {
    document.addEventListener('astro:page-load', initMobileNav);
    globalWindow.__mobileNavBound = true;
  }
</script>
