---
interface Props {
  playlistId: string;
  server?: string; // 'netease', 'tencent', 'kugou', 'xiami', 'baidu'
  type?: string;   // 'playlist', 'song', 'album', 'artist', 'search'
  fixed?: boolean;
  mini?: boolean;
  autoplay?: boolean;
  theme?: string;
  volume?: number;
}

const { 
  playlistId, 
  server = 'netease', 
  type = 'playlist',
  fixed = false,
  mini = false,
  autoplay = true,
  theme = '#2d4a3e', // Forest Green
  volume = 0.2
} = Astro.props;
---

<!-- Import APlayer and MetingJS Styles & Scripts -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.css">

<div class="music-player-container" id="music-player-container">
  <!-- Float Button (Side Tab Style) -->
  <button 
    class="music-toggle retro-card" 
    id="music-toggle" 
    aria-label="Toggle Music Player"
    title="Background Music"
  >
    <span class="icon">🎵</span>
    <span class="label">Music</span>
  </button>
  
  <!-- Player Panel (Wrapper for APlayer) -->
  <div class="music-panel retro-card" id="music-panel">
    <div class="music-header">
      <span class="title">Background Music</span>
      <button class="close-btn" id="music-close" aria-label="Close">×</button>
    </div>
    
    <!-- MetingJS Component -->
    <!-- 
      Refer to: https://github.com/metowolf/MetingJS 
      id: Song/Playlist ID
      server: music platform (netease, tencent, etc.)
      type: song, playlist, album, search, artist
      fixed: fixed mode
      mini: mini mode
      autoplay: auto play
      theme: theme color
      order: random / list
      loop: all / one / none
      preload: auto / metadata / none
      mutex: pause other players when this one plays
    -->
    <meting-js
      id={playlistId}
      server={server}
      type={type}
      fixed={fixed ? 'true' : 'false'}
      mini={mini ? 'true' : 'false'}
      autoplay={autoplay ? 'true' : 'false'}
      theme={theme}
      loop="all"
      order="list"
      preload="auto"
      list-folded="true"
      list-max-height="400px"
      lrc-type="0"
      volume={volume.toString()}
    ></meting-js>
  </div>
</div>

<script>
  // Dynamic import for MetingJS and APlayer to ensure they run client-side
  // We use CDN in script tags to ensure they load in order
</script>

<!-- Scripts must be loaded in the body or defer -->
<script is:inline src="https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/meting@2/dist/Meting.min.js"></script>

<script>
  const playerContainer = document.getElementById('music-player-container');
  const toggleBtn = document.getElementById('music-toggle');
  const closeBtn = document.getElementById('music-close');

  // Load state from localStorage
  const savedState = localStorage.getItem('musicPanelOpen');
  if (savedState === 'true') {
    playerContainer?.classList.add('open');
  }

  function togglePanel() {
    const isOpen = playerContainer?.classList.toggle('open');
    localStorage.setItem('musicPanelOpen', isOpen ? 'true' : 'false');
  }

  toggleBtn?.addEventListener('click', togglePanel);
  closeBtn?.addEventListener('click', () => {
    playerContainer?.classList.remove('open');
    localStorage.setItem('musicPanelOpen', 'false');
  });

  // Optional: Listen for APlayer events if needed
  // Note: APlayer instance is created by MetingJS automatically
</script>

<style>
  /* Container positioning - same as previous design */
  .music-player-container {
    position: fixed;
    right: 0;
    bottom: 25%;
    z-index: 40;
    font-family: 'Inter', sans-serif;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  /* Toggle Button - Side Tab Style */
  .music-toggle {
    width: auto;
    height: auto;
    min-width: 80px;
    padding: 8px 12px 8px 16px; 
    border-radius: 8px 0 0 8px;
    background: #2d4a3e;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 1px solid rgba(0,0,0,0.05);
    border-right: none;
    box-shadow: -2px 4px 6px rgba(0,0,0,0.1);
    letter-spacing: 0.5px;
  }

  .music-toggle:hover {
    transform: translateX(-4px); 
    background: #36574a;
  }

  .music-player-container.open .music-toggle {
    background: #8a6240; 
  }

  /* Panel Styling */
  .music-panel {
    position: absolute;
    bottom: auto;
    top: 50px; 
    right: 10px;
    
    width: 340px; /* Slightly wider for APlayer */
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
    border-radius: 8px;
    padding: 12px;
    opacity: 0;
    transform: translateX(20px);
    pointer-events: none;
    transition: all 0.3s ease;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(0,0,0,0.05);
  }

  .music-player-container.open .music-panel {
    opacity: 1;
    transform: translateX(0);
    pointer-events: all;
  }

  .music-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    margin-bottom: 8px;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #4a4a4a;
  }

  .close-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.25rem;
    color: #999;
    padding: 0 4px;
    line-height: 1;
    transition: color 0.2s;
  }

  .close-btn:hover {
    color: #333;
  }

  /* Customize APlayer Styles to match Blog Theme */
  :global(.aplayer) {
    margin: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
    font-family: inherit !important;
  }

  :global(.aplayer .aplayer-body) {
    background-color: transparent !important;
  }

  :global(.aplayer .aplayer-info) {
    border-bottom: none !important;
  }

  :global(.aplayer .aplayer-info .aplayer-music .aplayer-title) {
    color: #1a1a1a !important;
    font-weight: 600;
  }
  
  :global(.aplayer .aplayer-list ol li) {
    border-top: 1px solid #eee !important;
  }
  
  :global(.aplayer .aplayer-list ol li:hover) {
    background: rgba(138, 98, 64, 0.05) !important;
  }
  
  :global(.aplayer .aplayer-list ol li.aplayer-list-light) {
    background: rgba(138, 98, 64, 0.1) !important;
  }

  /* Hide lyrics to save space if needed, or keep them */
  :global(.aplayer .aplayer-lrc) {
    display: none !important; /* Optional: hide lyrics */
  }

  @media (max-width: 768px) {
    .music-toggle {
        padding: 8px 10px 8px 12px;
    }
    .music-toggle .label {
        display: none; 
    }
    .music-panel {
        right: 5px;
        width: 300px;
    }
  }
</style>
