const articles = [
  { href: 'l04', title: 'L04 渲染实践', desc: '现代游戏引擎渲染管线概述' },
  { href: 'l05', title: 'L05 光照与材质', desc: '全局光照与PBR材质系统' },
  { href: 'l06-1', title: 'L06-1 渲染地形', desc: '大规模地形渲染技术' },
  { href: 'l06-2', title: 'L06-2 渲染天空与大气', desc: '天空与大气散射渲染' },
  { href: 'l07', title: 'L07 渲染管线', desc: '延迟渲染与前向渲染' },
