---
// UnifiedSidebar.astro - 统一侧边栏组件
// 替代原有的 Sidebar.astro 和 SubPageSidebar.astro
import SearchBox from './SearchBox.astro';

export interface Props {
  currentSection?: 'home' | 'articles' | 'series' | 'tools' | 'videos' | 'about';
  showSearch?: boolean;
  showProfile?: boolean;
  showFilter?: boolean;
}

const { 
  currentSection = 'home',
  showSearch = true,
  showProfile = true,
  showFilter = true
} = Astro.props;

const sections = [
  { id: 'home', num: '00', label: '首页', labelEn: 'Home', href: '/' },
  { id: 'articles', num: '01', label: '文章列表', labelEn: 'Articles', href: '/articles/' },
  { id: 'series', num: '02', label: '系列笔记', labelEn: 'Series', href: '/series/' },
  { id: 'tools', num: '03', label: '工具库', labelEn: 'Tools', href: '/tools/' },
  { id: 'videos', num: '04', label: '视频教程', labelEn: 'Videos', href: '/videos/' },
  { id: 'about', num: '05', label: '关于', labelEn: 'About', href: '/about/' },
];
---

<aside class="hidden lg:block lg:col-span-3 relative">
  <div class="sidebar-sticky space-y-8">
    <!-- Profile Widget -->
    {showProfile && (
      <div class="rounded-[1.75rem] border border-ink/10 bg-white/80 p-6 shadow-[0_14px_34px_rgba(26,26,26,0.05)] backdrop-blur-sm">
        <div class="w-24 h-24 mx-auto overflow-hidden rounded-full border border-ink/10">
          <img loading="lazy" decoding="async" src="/Resource/ykmon.jpg" alt="Avatar" width="96" height="96" class="object-cover w-full h-full">
        </div>
        <div class="mt-4 text-center">
          <h3 class="font-serif text-xl font-bold mb-1 text-ink">YKMON</h3>
          <p class="text-[11px] text-ochre uppercase tracking-[0.3em] mb-4">Technical Artist</p>
          <p class="text-sm text-gray-600 leading-relaxed font-light">
          致力自动化管线开发，非传统技术美术，从项目管理到技术落地。
          </p>
        </div>
      </div>
    )}

    <!-- Search Box -->
    {showSearch && <SearchBox />}

    <!-- Navigation -->
    <nav class="rounded-[1.75rem] border border-ink/10 bg-white/70 p-5 shadow-[0_14px_34px_rgba(26,26,26,0.04)] backdrop-blur-sm space-y-4">
      <div class="flex items-center justify-between border-b border-ink/10 pb-3 mb-2">
        <h4 class="font-serif text-lg italic text-ink">Sections</h4>
        <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400">Navigation</span>
      </div>
      {sections.map((section) => (
        <a
          href={section.href}
          class:list={[
            'flex items-center justify-between rounded-2xl border px-4 py-3 transition-all duration-300 group',
            currentSection === section.id
              ? 'border-forest/20 bg-forest/6 text-forest shadow-[0_8px_20px_rgba(45,74,62,0.08)]'
              : 'border-transparent bg-transparent text-ink hover:border-ochre/10 hover:bg-white hover:text-ochre'
          ]}
        >
          <span class="flex items-center gap-3">
            <span class:list={[
              'text-[10px] font-bold tracking-[0.35em]',
              currentSection === section.id ? 'text-forest' : 'text-gray-400 group-hover:text-ochre'
            ]}>{section.num}</span>
            <span class="font-medium">{section.label}</span>
          </span>
          <span class="text-[10px] uppercase tracking-[0.25em] text-gray-400 group-hover:text-ochre">
            {section.labelEn}
          </span>
        </a>
      ))}
    </nav>
  </div>
</aside>
