---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/TopNav.astro';
import Footer from '../../components/Footer.astro';
import { seriesList } from '../../data/series';
---

<BaseLayout title="系列笔记 - TechArt Chronicle" description="图形学、游戏引擎、UE 源码与 Agent 工程的系统学习笔记。">
  <TopNav currentSection="series" />
  <main class="reading-width page-main">
    <header class="page-heading"><h1>系列笔记</h1><p>沿着一条线索，把零散的知识连接起来。</p></header>
    <div class="space-y-12">
      {seriesList.map((series) => (
        <section class="series-section">
          <div class="reading-list-title">
            <h2 class="text-2xl"><a class="text-link" href={`/articles/${series.id}/`}>{series.title}</a></h2>
            <span class="shrink-0 text-sm text-gray-400">{series.articles.length} 篇笔记</span>
          </div>
          <p class="mt-3 leading-7 text-gray-500">{series.description}</p>
          <ul class="mt-5 space-y-3 border-l border-gray-200 pl-5">
            {series.articles.slice(0, 4).map((article) => (
              <li><a class="text-gray-600 hover:text-ink hover:underline underline-offset-4" href={`/articles/${article.slug}/`}>{article.title}</a></li>
            ))}
          </ul>
          <a class="mt-5 inline-block text-sm text-gray-500 hover:underline" href={`/articles/${series.id}/`}>查看完整目录 →</a>
        </section>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
