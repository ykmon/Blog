---
// gallery/index.astro - 个人相册页
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/TopNav.astro';
import Footer from '../../components/Footer.astro';
import { formatDateCN } from '../../utils/date';
import { mapGalleryEntry, sortByDateDesc } from '../../utils/content';

const pageTitle = 'Gallery - TechArt Chronicle';
const description = 'YKMON 的个人相册，记录风景、扫街与日常观察。';

const galleryPhotos = sortByDateDesc(
  (await getCollection('gallery')).filter((entry) => entry.data.listed !== false).map(mapGalleryEntry)
);
const latestPhoto = galleryPhotos[0];
const filterOptions = Array.from(
  new Set(['风景', '扫街', ...galleryPhotos.flatMap((photo) => [photo.category, ...photo.tags])].filter(Boolean))
);
const categoryCount = new Set(galleryPhotos.map((photo) => photo.category)).size;
---

<BaseLayout title={pageTitle} description={description}>
  <TopNav currentSection="gallery" subPage />

  <div class="container mx-auto max-w-7xl px-4 py-12 md:px-6">
    <main class="space-y-12">
      <section class="blur-load overflow-hidden rounded-[2rem] border border-ink/10 bg-white/80 shadow-[0_18px_50px_rgba(26,26,26,0.06)]">
        <div class="grid gap-0 lg:grid-cols-[minmax(0,1fr),360px]">
          <div class="p-6 md:p-8 lg:p-10">
            <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">Gallery / Personal Archive</p>
            <h1 class="mt-4 max-w-3xl font-serif text-4xl leading-tight text-ink md:text-6xl">
              风景、街角和偶然遇见的光
            </h1>
            <p class="mt-5 max-w-2xl text-sm leading-7 text-gray-600 md:text-base">
              这里收纳个人拍摄的风景与扫街照片。相册会保持轻量整理，只记录标题、地点与拍摄日期，把照片本身留在第一位。
            </p>
          </div>

          <div class="border-t border-ink/10 bg-[linear-gradient(180deg,rgba(45,74,62,0.96),rgba(26,26,26,0.96))] p-6 text-paper md:p-8 lg:border-l lg:border-t-0">
            <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-paper/55">Archive Status</p>
            <div class="mt-6 grid grid-cols-2 gap-3">
              <div class="rounded-2xl border border-paper/10 bg-paper/5 p-4">
                <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-paper/45">Photos</div>
                <div class="mt-2 font-serif text-3xl">{galleryPhotos.length}</div>
              </div>
              <div class="rounded-2xl border border-paper/10 bg-paper/5 p-4">
                <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-paper/45">Scenes</div>
                <div class="mt-2 font-serif text-3xl">{categoryCount}</div>
              </div>
            </div>
            <div class="mt-4 rounded-2xl border border-paper/10 bg-paper/5 p-4">
              <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-paper/45">Latest</div>
              <div class="mt-2 font-serif text-2xl">
                {latestPhoto ? formatDateCN(latestPhoto.date) : '整理中'}
              </div>
              <p class="mt-2 text-sm leading-6 text-paper/65">
                {latestPhoto ? `${latestPhoto.location} / ${latestPhoto.category}` : '照片目录已经准备好，等待第一组作品入库。'}
              </p>
            </div>
          </div>
        </div>
      </section>

      {galleryPhotos.length > 0 ? (
        <>
          <section class="blur-load space-y-5" data-gallery-root>
            <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">Browse</p>
                <h2 class="mt-2 font-serif text-3xl text-ink">按主题浏览照片</h2>
              </div>
              <div class="text-sm text-gray-500">
                <span data-gallery-count>{galleryPhotos.length}</span> / {galleryPhotos.length} photos
              </div>
            </div>

            <div class="flex flex-wrap gap-2 rounded-[1.5rem] border border-ink/10 bg-white/70 p-4">
              <button
                type="button"
                class="gallery-filter-btn active rounded-full border border-forest bg-forest px-4 py-2 text-xs font-bold uppercase tracking-[0.28em] text-white transition-all"
                data-gallery-filter="all"
              >
                全部
              </button>
              {filterOptions.map((filter) => (
                <button
                  type="button"
                  class="gallery-filter-btn rounded-full border border-ink/10 bg-paper px-4 py-2 text-xs font-bold uppercase tracking-[0.28em] text-ink transition-all hover:-translate-y-0.5 hover:border-ochre hover:text-ochre"
                  data-gallery-filter={filter}
                >
                  {filter}
                </button>
              ))}
            </div>

            <div class="gallery-masonry" data-gallery-grid>
              {galleryPhotos.map((photo, index) => {
                const filters = [photo.category, ...photo.tags].join(',');

                return (
                  <article
                    class="gallery-card group mb-5 break-inside-avoid overflow-hidden rounded-[1.35rem] border border-ink/10 bg-white shadow-[0_12px_28px_rgba(26,26,26,0.05)] transition-all duration-300 hover:-translate-y-1 hover:border-ochre hover:shadow-[0_18px_42px_rgba(138,98,64,0.14)]"
                    data-gallery-card
                    data-gallery-filters={filters}
                  >
                    <button
                      type="button"
                      class="block w-full text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ochre/70"
                      data-gallery-open
                      data-title={photo.title}
                      data-location={photo.location}
                      data-date={formatDateCN(photo.date)}
                      data-category={photo.category}
                      data-description={photo.description ?? ''}
                      data-image={photo.image}
                      data-alt={photo.imageAlt}
                    >
                      <div class="overflow-hidden bg-forest">
                        <img
                          loading={index < 4 ? 'eager' : 'lazy'}
                          decoding="async"
                          src={photo.image}
                          alt={photo.imageAlt}
                          class="h-auto w-full transition-transform duration-700 group-hover:scale-[1.03]"
                        />
                      </div>
                      <div class="p-4">
                        <div class="flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.25em]">
                          <span class="rounded-full bg-forest/10 px-2.5 py-1 text-forest">{photo.category}</span>
                          <span class="text-gray-400">{formatDateCN(photo.date)}</span>
                        </div>
                        <h3 class="mt-3 font-serif text-xl leading-tight text-ink transition-colors group-hover:text-forest">
                          {photo.title}
                        </h3>
                        <p class="mt-2 text-sm leading-6 text-gray-600">{photo.location}</p>
                        {photo.description && (
                          <p class="mt-2 line-clamp-2 text-sm leading-6 text-gray-500">{photo.description}</p>
                        )}
                      </div>
                    </button>
                  </article>
                );
              })}
            </div>
          </section>

          <div
            id="gallery-lightbox"
            class="fixed inset-0 z-[80] hidden bg-ink/90 p-4 backdrop-blur-sm md:p-8"
            aria-hidden="true"
          >
            <button
              type="button"
              class="absolute inset-0 h-full w-full cursor-default"
              data-gallery-close
              aria-label="关闭相册预览"
            ></button>

            <div class="relative mx-auto flex h-full max-w-6xl flex-col justify-center">
              <button
                type="button"
                class="absolute right-0 top-0 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full border border-paper/20 bg-paper/10 text-paper transition-all hover:bg-paper/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper/70"
                data-gallery-close
                aria-label="关闭相册预览"
              >
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>

              <figure class="relative grid max-h-full gap-5 pt-14 lg:grid-cols-[minmax(0,1fr),320px] lg:items-center lg:pt-0">
                <div class="flex min-h-0 items-center justify-center">
                  <img
                    id="gallery-lightbox-image"
                    src=""
                    alt=""
                    class="max-h-[70vh] w-auto max-w-full rounded-[1rem] object-contain shadow-[0_24px_70px_rgba(0,0,0,0.35)] lg:max-h-[82vh]"
                  />
                </div>
                <figcaption class="rounded-[1.25rem] border border-paper/10 bg-paper/10 p-5 text-paper backdrop-blur">
                  <div id="gallery-lightbox-meta" class="text-[10px] font-bold uppercase tracking-[0.3em] text-paper/55"></div>
                  <h2 id="gallery-lightbox-title" class="mt-3 font-serif text-3xl leading-tight"></h2>
                  <p id="gallery-lightbox-location" class="mt-3 text-sm leading-6 text-paper/75"></p>
                  <p id="gallery-lightbox-description" class="mt-4 text-sm leading-7 text-paper/65"></p>
                </figcaption>
              </figure>
            </div>
          </div>
        </>
      ) : (
        <section class="blur-load rounded-[2rem] border border-dashed border-ink/15 bg-white/70 p-8 text-center md:p-12">
          <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">Coming Soon</p>
          <h2 class="mt-3 font-serif text-3xl text-ink">相册整理中</h2>
          <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-gray-600">
            页面结构已经就绪。之后把照片放入 <code class="rounded bg-paper px-1.5 py-0.5 text-ochre">public/images/gallery</code>，
            并在 <code class="rounded bg-paper px-1.5 py-0.5 text-ochre">src/content/gallery</code> 添加对应条目即可展示。
          </p>
        </section>
      )}

      <div class="mt-20 flex items-center justify-between border-t border-gray-300 pt-8 font-serif text-sm italic text-gray-500">
        <span>共 {galleryPhotos.length} 张照片</span>
        <a href="#top" class="text-ochre hover:underline">Back to Top →</a>
      </div>
    </main>
  </div>

  <Footer />
</BaseLayout>

<style>
  .gallery-masonry {
    column-count: 1;
    column-gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .gallery-masonry {
      column-count: 2;
    }
  }

  @media (min-width: 1024px) {
    .gallery-masonry {
      column-count: 3;
    }
  }

  .gallery-filter-btn.active {
    background-color: #2d4a3e;
    border-color: #2d4a3e;
    color: white;
  }

  .gallery-card.is-hidden {
    display: none;
  }

  body.gallery-lightbox-open {
    overflow: hidden;
  }
</style>

<script>
  let galleryAbort: AbortController | null = null;

  function initGalleryPage() {
    if (galleryAbort) {
      galleryAbort.abort();
    }

    galleryAbort = new AbortController();
    const { signal } = galleryAbort;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-gallery-card]'));
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]'));
    const count = document.querySelector<HTMLElement>('[data-gallery-count]');
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImage = document.getElementById('gallery-lightbox-image') as HTMLImageElement | null;
    const lightboxMeta = document.getElementById('gallery-lightbox-meta');
    const lightboxTitle = document.getElementById('gallery-lightbox-title');
    const lightboxLocation = document.getElementById('gallery-lightbox-location');
    const lightboxDescription = document.getElementById('gallery-lightbox-description');

    const setActiveFilter = (activeFilter: string) => {
      let visibleCount = 0;

      cards.forEach((card) => {
        const filters = (card.dataset.galleryFilters ?? '').split(',').filter(Boolean);
        const isVisible = activeFilter === 'all' || filters.includes(activeFilter);
        card.classList.toggle('is-hidden', !isVisible);
        if (isVisible) visibleCount += 1;
      });

      filterButtons.forEach((button) => {
        button.classList.toggle('active', button.dataset.galleryFilter === activeFilter);
      });

      if (count) {
        count.textContent = String(visibleCount);
      }
    };

    filterButtons.forEach((button) => {
      button.addEventListener(
        'click',
        () => {
          setActiveFilter(button.dataset.galleryFilter ?? 'all');
        },
        { signal }
      );
    });

    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.classList.add('hidden');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('gallery-lightbox-open');
      if (lightboxImage) {
        lightboxImage.src = '';
        lightboxImage.alt = '';
      }
    };

    document.querySelectorAll<HTMLElement>('[data-gallery-open]').forEach((button) => {
      button.addEventListener(
        'click',
        () => {
          if (!lightbox || !lightboxImage || !lightboxMeta || !lightboxTitle || !lightboxLocation || !lightboxDescription) return;

          lightboxImage.src = button.dataset.image ?? '';
          lightboxImage.alt = button.dataset.alt ?? '';
          lightboxMeta.textContent = `${button.dataset.category ?? ''} / ${button.dataset.date ?? ''}`;
          lightboxTitle.textContent = button.dataset.title ?? '';
          lightboxLocation.textContent = button.dataset.location ?? '';
          lightboxDescription.textContent = button.dataset.description ?? '';
          lightbox.classList.remove('hidden');
          lightbox.setAttribute('aria-hidden', 'false');
          document.body.classList.add('gallery-lightbox-open');
        },
        { signal }
      );
    });

    document.querySelectorAll('[data-gallery-close]').forEach((button) => {
      button.addEventListener('click', closeLightbox, { signal });
    });

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape') {
          closeLightbox();
        }
      },
      { signal }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGalleryPage);
  } else {
    initGalleryPage();
  }

  const galleryWindow = window as Window & { __galleryPageBound?: boolean };
  if (!galleryWindow.__galleryPageBound) {
    document.addEventListener('astro:page-load', initGalleryPage);
    galleryWindow.__galleryPageBound = true;
  }
</script>
