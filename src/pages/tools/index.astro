---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/TopNav.astro';
import Footer from '../../components/Footer.astro';
import { mapToolEntry, sortByDateDesc } from '../../utils/content';
const tools = sortByDateDesc((await getCollection('tools')).map(mapToolEntry));
---

<BaseLayout title="工具库 - TechArt Chronicle" description="Houdini 脚本与程序化工作流中的实用小工具。">
  <TopNav currentSection="tools" />
  <main class="reading-width page-main">
    <header class="page-heading"><h1>工具库</h1><p>减少重复操作，把时间留给内容本身。这里收录 {tools.length} 个实用工具与脚本。</p></header>
    <div class="reading-list">
      {tools.map((tool) => (
        <article class="reading-list-item">
          <h2 class="text-xl"><a class="text-link" href={tool.href}>{tool.title}</a></h2>
          <p>{tool.description}</p>
        </article>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
