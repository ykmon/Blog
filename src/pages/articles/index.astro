---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/TopNav.astro';
import Footer from '../../components/Footer.astro';
import SearchBox from '../../components/SearchBox.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { countTags, mapArticleEntry, sortByDateDesc } from '../../utils/content';

const articles = sortByDateDesc(
  (await getCollection('articles')).filter((entry) => entry.data.listed !== false).map(mapArticleEntry)
);
const filterTags = countTags(articles);
---

<BaseLayout title="文章 - TechArt Chronicle" description="Unreal Engine、Houdini、Shader 和图形学的技术美术实践笔记。">
  <TopNav currentSection="articles" showSearch={false} />
  <main class="reading-width page-main" data-filter-root>
    <header class="page-heading">
      <h1>文章</h1>
      <p>关于引擎、图形学与工作流的笔记，共 {articles.length} 篇。</p>
    </header>
    <section class="article-filters" aria-label="搜索与标签筛选">
      <SearchBox />
      <div class="flex flex-wrap gap-2">
        {filterTags.map(({ tag, count }) => (
          <button class="tag-filter-btn" data-tag={tag} aria-pressed="false">{tag}<span>{count}</span></button>
        ))}
      </div>
      <div class="mt-4 flex flex-wrap gap-3 text-sm text-gray-500">
        <span data-role="filter-status" class="hidden"><span data-role="filter-count"></span></span>
        <button data-role="clear-filters" class="hidden underline underline-offset-4">清空标签</button>
      </div>
    </section>
    <section class="reading-list" data-section="articles" aria-label="文章列表">
      {articles.map((article) => <ArticleCard {...article} />)}
    </section>
    <p class="filter-empty hidden text-gray-500" data-role="filter-empty" role="status">没有找到匹配的文章，试试其他关键词或清空筛选。</p>
  </main>
  <Footer />
</BaseLayout>
