---
// tools/index.astro - 工具列表页
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = 'Houdini Tools - TechArt Chronicle';
const description = 'Houdini 工具库 - Python 脚本和 HDA 开发技巧收录，提升程序化工作流效率。';

const tools = [
  {
    href: '/tools/switch-to-output-group/',
    icon: '☊',
    title: '从 Switch 创建输出组',
    description: 'Quickly create output groups from switch nodes'
  },
  {
    href: '/tools/add-handle-to-hda/',
    icon: '🔧',
    title: '如何为 HDA 添加 Handle',
    description: 'Adding custom handles to Houdini Digital Assets'
  },
  {
    href: '/tools/quick-add-parameter/',
    icon: '⚡',
    title: '快速添加自定义 Parameter',
    description: 'Quickly add custom parameters scripts'
  },
  {
    href: '/tools/batch-create-object-merge/',
    icon: '⛓️',
    title: '批量创建选中的 ObjectMerge',
    description: 'Batch create Object Merge nodes for selection'
  },
  {
    href: '/tools/split-geometry-by-group/',
    icon: '✂️',
    title: '按照组拆分模型',
    description: 'Split geometry by groups automatically'
  },
  {
    href: '/tools/node-input-count/',
    icon: '🔢',
    title: '节点输入数量',
    description: 'Managing node input connections util'
  },
];
---

<BaseLayout title={pageTitle} description={description} canonical="https://ykmon.github.io/Blog/tools/">
  <!-- Header -->
  <header class="py-12 md:py-16 text-center border-b border-gray-300 relative bg-paper z-10">
    <div class="container mx-auto px-6">
      <a href="/" class="inline-block">
        <div class="text-xs font-bold tracking-[0.3em] uppercase text-ochre mb-2 font-serif">TechArt Chronicle</div>
        <h1 class="font-serif text-3xl md:text-5xl font-bold tracking-tight text-ink">Library</h1>
      </a>
    </div>
  </header>

  <div class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

      <!-- SIDEBAR -->
      <aside class="hidden lg:block lg:col-span-3 relative">
        <div class="sidebar-sticky space-y-12">
          <nav class="space-y-4">
            <a href="/" class="block text-ink hover:text-ochre transition-colors group">
              <span class="text-xs font-bold text-gray-400 mr-2 group-hover:text-ochre">←</span> Back to Home
            </a>
            <div class="h-px bg-gray-300 my-4"></div>
            <h4 class="font-serif text-lg pb-2 mb-2 italic text-gray-400">Sections</h4>
            <a href="/articles/" class="block text-ink hover:text-ochre transition-colors">Articles</a>
            <a href="/videos/" class="block text-ink hover:text-ochre transition-colors">Videos</a>
            <a href="/tools/" class="block text-ochre font-bold transition-colors">Tools</a>
          </nav>
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <main class="lg:col-span-8 lg:col-start-5 relative">
        <article class="prose prose-lg prose-slate max-w-none mb-12">
          <span class="text-ochre font-bold text-xs tracking-wider uppercase mb-2 block">Houdini / Python</span>
          <h1 class="font-serif text-4xl mb-4 leading-tight">Procedural Toolset</h1>
          <p class="text-gray-600 italic">Houdini 项目中使用的部分 Python 脚本和 HDA 开发技巧收录。</p>
        </article>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {tools.map((tool) => (
            <a href={tool.href} class="retro-card p-6 block group">
              <div class="text-ochre text-2xl mb-2 group-hover:scale-110 transition-transform origin-left">{tool.icon}</div>
              <h3 class="font-bold text-lg mb-2 font-serif text-ink">{tool.title}</h3>
              <p class="text-sm text-gray-500">{tool.description}</p>
            </a>
          ))}
        </div>

        <div class="mt-20 border-t border-gray-300 pt-8 flex justify-between items-center text-sm font-serif italic text-gray-500">
          <span>Index</span>
          <a href="#" class="text-ochre hover:underline">Back to Top ↑</a>
        </div>
      </main>
    </div>
  </div>

  <Footer />
</BaseLayout>
