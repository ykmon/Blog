---
// videos/index.astro - 视频列表页
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SubPageSidebar from '../../components/SubPageSidebar.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = 'Videos - TechArt Chronicle';
const description = '技术美术视频教程 - Houdini 程序化、Unreal Engine PCG、布料解算等技术演示。';

import { videos } from '../../data/content';
---

<BaseLayout title={pageTitle} description={description}>
  <Header title="Motion" subPage />

  <div class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

      <SubPageSidebar currentSection="videos" />

      <!-- MAIN CONTENT -->
      <main class="lg:col-span-8 lg:col-start-5 relative">
        <div class="mb-12">
          <span class="text-ochre font-bold text-xs tracking-wider uppercase mb-2 block">Video Gallery</span>
          <p class="text-gray-600 italic font-serif">Visual explorations and technical demonstrations.</p>
        </div>

        <div class="grid gap-16">
          {videos.map((video) => (
            <article class="retro-frame p-2">
              <div class="aspect-video bg-gray-800 relative overflow-hidden group">
                <iframe
                  src={`https://player.bilibili.com/player.html?isOutside=true&aid=${video.aid}&bvid=${video.bvid}&cid=${video.cid}&p=1&autoplay=0`}
                  title={video.title}
                  class="absolute top-0 left-0 w-full h-full"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
              <div class="p-6 md:flex justify-between items-end">
                <div>
                  <h3 class="font-serif text-2xl font-bold italic mb-1">{video.title}</h3>
                  <p class="text-xs text-gray-500 uppercase tracking-widest">{video.category}</p>
                </div>
                <div class="text-ochre mt-4 md:mt-0 text-sm">{video.date} • Bilibili</div>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-20 border-t border-gray-300 pt-8 flex justify-between items-center text-sm font-serif italic text-gray-500">
          <span>Page 1 of 1</span>
          <a href="#" class="text-ochre hover:underline">Back to Top ↑</a>
        </div>
      </main>
    </div>
  </div>

  <Footer />
</BaseLayout>
