---
// ArticleLayout.astro - 文章页面布局模板
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import SubPageSidebar from '../components/SubPageSidebar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  category: string;
  categoryLink?: string;
  date?: string;
  description?: string;
  image?: string;
  keywords?: string;
}

const { 
  title, 
  category, 
  categoryLink = '/articles/',
  date,
  description,
  image,
  keywords
} = Astro.props;
---

<BaseLayout title={`${title} - TechArt Chronicle`} description={description} image={image} keywords={keywords}>
  <Header title={category} subPage />

  <div class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

      <SubPageSidebar currentSection="articles" />

      <!-- MAIN CONTENT -->
      <main class="lg:col-span-8 lg:col-start-5 relative">
        <article class="prose prose-lg prose-slate max-w-none">
          <span class="text-ochre font-bold text-xs tracking-wider uppercase mb-2 block">{category}</span>
          <h1 class="font-serif text-4xl md:text-5xl mb-8 leading-tight">{title}</h1>
          {date && <div class="text-sm text-gray-500 font-serif italic mb-8">{date}</div>}
          
          <slot />
        </article>

        <div class="mt-20 border-t border-gray-300 pt-8 flex justify-between items-center text-sm font-serif italic text-gray-500">
          <a href={categoryLink} class="text-ochre hover:underline">← Back to Articles</a>
          <a href="#top" class="text-ochre hover:underline">Back to Top ↑</a>
        </div>
      </main>
    </div>
  </div>

  <Footer />
</BaseLayout>
