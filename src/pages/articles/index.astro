---
// articles/index.astro - 鏂囩珷鍒楄〃椤碉紙缂栬緫閮ㄦ。妗堥鏍硷級
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import TopNav from '../../components/TopNav.astro';
import Footer from '../../components/Footer.astro';
import type { Article } from '../../data/content';
import { formatDateEN, parseISODate } from '../../utils/date';

const pageTitle = 'Articles - TechArt Chronicle';
const description = '技术美术文章合集 - Unreal Engine、Unity Shader、Houdini、GAMES 系列课程笔记等。';

const collectionArticles: Article[] = (await getCollection('articles'))
  .filter((entry: CollectionEntry<'articles'>) => entry.data.listed !== false)
  .map((entry: CollectionEntry<'articles'>) => {
    const href = entry.data.href ?? `/articles/${entry.slug}/`;
    return {
      type: 'article',
      href,
      title: entry.data.title,
      category: entry.data.category,
      tags: entry.data.tags ?? [],
      description: entry.data.description,
      date: entry.data.date ?? '1970-01-01',
      readTime: entry.data.readTime,
      image: entry.data.image,
      imageAlt: entry.data.imageAlt,
      placeholder: entry.data.placeholder,
    };
  });

const sortedArticles = [...collectionArticles].sort((a, b) => parseISODate(b.date) - parseISODate(a.date));
const featuredArticles = sortedArticles.slice(0, 3);
const restArticles = sortedArticles.slice(3);

const categories = [...new Set(sortedArticles.map((a) => a.category))];
const articleTagCounts = sortedArticles.reduce((acc, article) => {
  article.tags.forEach((tag) => {
    acc[tag] = (acc[tag] ?? 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);
const filterTags = Object.entries(articleTagCounts)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'en'))
  .map(([tag, count]) => ({ tag, count }));

const articlesByYear = restArticles.reduce((acc, article) => {
  const year = article.date.split('-')[0];
  if (!acc[year]) acc[year] = [];
  acc[year].push(article);
  return acc;
}, {} as Record<string, Article[]>);

const years = Object.keys(articlesByYear).sort((a, b) => Number(b) - Number(a));

const categoryColors: Record<string, string> = {
  'Unreal Engine': 'bg-forest/10 text-forest border-forest/20',
  'Unity': 'bg-green-100 text-green-700 border-green-200',
  'Houdini': 'bg-ochre/10 text-ochre border-ochre/20',
  'Computer Graphics': 'bg-purple-100 text-purple-700 border-purple-200',
  'Game Engine': 'bg-red-100 text-red-700 border-red-200',
  'DevOps': 'bg-gray-100 text-gray-700 border-gray-200',
};

const getCategoryColor = (cat: string) => categoryColors[cat] || 'bg-gray-100 text-gray-700 border-gray-200';
---

<BaseLayout title={pageTitle} description={description}>
  <TopNav currentSection="articles" subPage />
  <Header title="Archive" subPage />

  <div class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
    <main class="space-y-12" data-articles-filter="enhanced">
        <section class="blur-load rounded-[2rem] border border-ink/10 bg-white/80 p-6 md:p-8 shadow-[0_18px_48px_rgba(26,26,26,0.06)]">
          <div class="grid gap-8 lg:grid-cols-[1.2fr,0.8fr] lg:items-center">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">Archive / All Posts</p>
              <h1 class="mt-3 font-serif text-4xl md:text-5xl xl:text-6xl leading-[0.95] text-ink">
                鏂囩珷绱㈠紩
              </h1>
              <p class="mt-4 max-w-3xl text-sm md:text-base leading-7 text-gray-600">
                鎸夊垎绫汇€佺簿閫夊拰骞翠唤娴忚鏂囩珷銆?
              </p>

              <div class="mt-6 flex flex-wrap gap-3">
                <a href="#featured" class="inline-flex items-center justify-center rounded-full bg-forest px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-forest/90">
                  绮鹃€?
                </a>
                <a href="#timeline" class="inline-flex items-center justify-center rounded-full border border-ink/15 bg-white px-5 py-2.5 text-sm font-semibold text-ink transition-all duration-300 hover:-translate-y-0.5 hover:border-ochre hover:text-ochre">
                  鏃堕棿绾?
                </a>
              </div>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
              <div class="rounded-[1.5rem] border border-ink/10 bg-paper p-5">
                <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400">Total</div>
                <div class="mt-2 font-serif text-3xl text-ink">{sortedArticles.length}</div>
                <div class="mt-2 text-sm leading-6 text-gray-600">绡囨枃绔犲唴瀹瑰彲娴忚</div>
              </div>
              <div class="rounded-[1.5rem] border border-ink/10 bg-paper p-5">
                <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400">Categories</div>
                <div class="mt-2 font-serif text-3xl text-ink">{categories.length}</div>
                <div class="mt-2 text-sm leading-6 text-gray-600">涓垎绫诲叆鍙?/div>
              </div>
              <div class="rounded-[1.5rem] border border-ink/10 bg-paper p-5">
                <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400">Featured</div>
                <div class="mt-2 font-serif text-3xl text-ink">{featuredArticles.length}</div>
                <div class="mt-2 text-sm leading-6 text-gray-600">绡囩簿閫夊唴瀹?/div>
              </div>
              <div class="rounded-[1.5rem] border border-ink/10 bg-paper p-5">
                <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400">Latest</div>
                <div class="mt-2 font-serif text-3xl text-ink">{sortedArticles[0] ? formatDateEN(sortedArticles[0].date) : '--'}</div>
                <div class="mt-2 text-sm leading-6 text-gray-600">鏈€杩戜竴娆℃洿鏂?/div>
              </div>
            </div>
          </div>
        </section>

        <section class="blur-load space-y-5" data-role="article-tag-filter">
          <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">绛涢€?Filter</p>
              <h2 class="mt-2 font-serif text-3xl text-ink">鎸夋爣绛剧瓫閫?/h2>
              <p class="mt-2 max-w-2xl text-sm leading-7 text-gray-600">
                鏀寔澶氭爣绛惧叡閫夛紝浠讳竴鏍囩鍛戒腑鍗冲彲鏄剧ず鏂囩珷銆?
              </p>
            </div>
          </div>

          <div class="rounded-[1.5rem] border border-ink/10 bg-white/70 p-4 space-y-3">
            <div class="flex flex-wrap gap-2">
              <button class="tag-filter-btn active rounded-full border border-forest/20 bg-forest px-4 py-2 text-xs font-bold uppercase tracking-[0.3em] text-white transition-all" data-tag-filter="all">
                鍏ㄩ儴 ({sortedArticles.length})
              </button>
              {filterTags.map(({ tag, count }) => (
                <button
                  class="tag-filter-btn rounded-full border border-ink/10 bg-paper px-4 py-2 text-xs font-bold uppercase tracking-[0.3em] text-ink transition-all hover:-translate-y-0.5 hover:border-ochre hover:text-ochre"
                  data-tag-filter={tag}
                >
                  {tag} ({count})
                </button>
              ))}
            </div>

            <div class="flex flex-wrap items-center gap-3 text-sm text-gray-600">
              <span data-role="tag-filter-status">鏄剧ず鍏ㄩ儴 {sortedArticles.length} 绡囨枃绔?/span>
              <button data-role="tag-filter-clear" class="hidden text-ochre hover:underline">娓呯┖鏍囩</button>
            </div>
          </div>
        </section>

        <section class="blur-load space-y-5" data-section="featured" id="featured">
          <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">绮鹃€夊唴瀹?Featured</p>
              <h2 class="mt-2 font-serif text-3xl text-ink">鏈€鏂颁笖鏈€鍊煎緱鍏堣鐨勬枃绔?/h2>
            </div>
            <a href="/articles/" class="text-sm font-semibold text-gray-500 transition-colors hover:text-ochre">鏌ョ湅鍏ㄩ儴鏂囩珷 鈫?/a>
          </div>

          <div class="grid gap-6 lg:grid-cols-12">
            {featuredArticles[0] && (
              <a
                href={featuredArticles[0].href}
                class="article-card group lg:col-span-7 overflow-hidden rounded-[1.75rem] border border-ink/10 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-ochre hover:shadow-[0_18px_42px_rgba(138,98,64,0.14)]"
                data-filter-tags={featuredArticles[0].tags.join(',')}
              >
                <div class="relative aspect-[16/10] overflow-hidden bg-forest">
                  {featuredArticles[0].image ? (
                    <img
                      loading="lazy"
                      decoding="async"
                      src={featuredArticles[0].image}
                      alt={featuredArticles[0].imageAlt ?? featuredArticles[0].title}
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.12),transparent_35%),linear-gradient(135deg,#2d4a3e,#1a1a1a)] px-8 text-center font-serif text-3xl text-paper">
                      {featuredArticles[0].category}
                    </div>
                  )}
                  <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-ink/80 to-transparent"></div>
                  <div class="absolute left-5 top-5 rounded-full bg-paper/90 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.3em] text-forest backdrop-blur">
                    Featured 01
                  </div>
                </div>
                <div class="p-6 md:p-7">
                  <div class="flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.3em]">
                    <span class="rounded-full bg-forest/10 px-2.5 py-1 text-forest">{featuredArticles[0].category}</span>
                    {featuredArticles[0].readTime && <span class="text-gray-400">{featuredArticles[0].readTime}</span>}
                    <span class="text-gray-300">鈥?/span>
                    <span class="text-gray-400">{formatDateEN(featuredArticles[0].date)}</span>
                  </div>
                  <h3 class="mt-4 font-serif text-2xl leading-tight text-ink transition-colors group-hover:text-forest md:text-3xl">
                    {featuredArticles[0].title}
                  </h3>
                  <p class="mt-4 max-w-2xl text-sm leading-7 text-gray-600 md:text-base">
                    {featuredArticles[0].description}
                  </p>
                </div>
              </a>
            )}

            <div class="lg:col-span-5 space-y-4">
              {featuredArticles.slice(1).map((article, index) => (
                <a
                  href={article.href}
                  class="article-card group block overflow-hidden rounded-[1.5rem] border border-ink/10 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-ochre hover:shadow-[0_18px_42px_rgba(138,98,64,0.14)]"
                  data-filter-tags={article.tags.join(',')}
                >
                  <div class="grid gap-0 md:grid-cols-[160px,1fr]">
                    <div class="aspect-[16/10] bg-forest md:aspect-auto">
                      {article.image ? (
                        <img
                          loading="lazy"
                          decoding="async"
                          src={article.image}
                          alt={article.imageAlt ?? article.title}
                          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                      ) : (
                        <div class="flex h-full w-full items-center justify-center bg-[linear-gradient(135deg,#2d4a3e,#8a6240)] font-serif text-2xl text-paper">
                          {String(index + 2).padStart(2, '0')}
                        </div>
                      )}
                    </div>
                    <div class="p-5">
                      <div class="flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.3em]">
                        <span class="rounded-full bg-ochre/10 px-2.5 py-1 text-ochre">{String(index + 2).padStart(2, '0')}</span>
                        <span class="rounded-full bg-gray-100 px-2.5 py-1 text-gray-600">{article.category}</span>
                        {article.readTime && <span class="text-gray-400">{article.readTime}</span>}
                      </div>
                      <h3 class="mt-3 font-serif text-xl leading-tight text-ink transition-colors group-hover:text-forest">
                        {article.title}
                      </h3>
                      <p class="mt-3 text-sm leading-6 text-gray-600 line-clamp-3">
                        {article.description}
                      </p>
                      <div class="mt-4 text-xs font-semibold uppercase tracking-[0.25em] text-gray-400">
                        {formatDateEN(article.date)}
                      </div>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>

        <section class="blur-load space-y-5" id="timeline" data-blur-priority="eager">
          <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">鏃堕棿绾?Timeline</p>
              <h2 class="mt-2 font-serif text-3xl text-ink">鎸夊勾浠芥祻瑙堝墿浣欐枃绔?/h2>
            </div>
          </div>

          {years.map((year) => (
            <div class="year-section space-y-4" data-year={year}>
              <h3 class="sticky top-4 z-10 flex items-center gap-3 rounded-full border border-ink/10 bg-paper/90 px-4 py-2 font-serif text-2xl text-ink backdrop-blur-sm">
                <span class="text-ochre">{year}</span>
                <span class="flex-1 h-px bg-gray-200"></span>
                <span class="text-sm font-normal text-gray-400">{articlesByYear[year].length} 绡?/span>
              </h3>
              <div class="space-y-3">
                {articlesByYear[year].map((article) => (
                  <a
                    href={article.href}
                    class="article-card group block rounded-[1.35rem] border border-ink/10 bg-white/85 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-ochre hover:shadow-[0_14px_32px_rgba(138,98,64,0.12)]"
                    data-filter-tags={article.tags.join(',')}
                  >
                    <div class="grid gap-4 md:grid-cols-[72px,108px,1fr,auto] md:items-center">
                      <div class="text-xs font-mono text-gray-400">{article.date.slice(5)}</div>

                      <div class="overflow-hidden rounded-2xl bg-forest">
                        {article.image ? (
                          <img
                            loading="lazy"
                            decoding="async"
                            src={article.image}
                            alt={article.imageAlt ?? article.title}
                            class="aspect-[4/3] h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                          />
                        ) : (
                          <div class="flex aspect-[4/3] items-center justify-center bg-[linear-gradient(135deg,#2d4a3e,#8a6240)] font-serif text-xs uppercase tracking-[0.25em] text-paper">
                            {article.category.slice(0, 3)}
                          </div>
                        )}
                      </div>

                      <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.3em]">
                          <span class={`rounded-full border px-2.5 py-1 ${getCategoryColor(article.category)}`}>
                            {article.category}
                          </span>
                          {article.readTime === 'Series' && (
                            <span class="text-forest">馃搧 SERIES</span>
                          )}
                        </div>
                        <h4 class="mt-3 font-serif text-lg leading-tight text-ink transition-colors group-hover:text-forest">
                          {article.title}
                        </h4>
                        <p class="mt-2 text-sm leading-6 text-gray-500 line-clamp-2">
                          {article.description}
                        </p>
                      </div>

                      <div class="text-right text-sm text-gray-400">
                        <span class="inline-flex items-center gap-2 font-semibold text-ochre transition-transform duration-300 group-hover:translate-x-1">
                          鈫?
                        </span>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </section>

        <div class="mt-20 border-t border-gray-300 pt-8 flex justify-between items-center text-sm font-serif italic text-gray-500">
          <span>鍏?{sortedArticles.length} 绡囨枃绔?/span>
          <a href="#top" class="text-ochre hover:underline">Back to Top 鈫?/a>
        </div>
    </main>
  </div>

  <Footer />
</BaseLayout>

<style>
  .tag-filter-btn {
    cursor: pointer;
  }
  .tag-filter-btn.active {
    background-color: #2d4a3e;
    color: white;
    border-color: #2d4a3e;
  }
  .tag-filter-btn:not(.active):hover {
    transform: translateY(-1px);
  }
  .article-card.hidden {
    display: none;
  }
  .year-section.hidden {
    display: none;
  }
</style>

<script>
  let articleFilterAbort: AbortController | null = null;

  function parseTags(value: string | null): string[] {
    if (!value) return [];
    return value.split(',').map((tag) => tag.trim()).filter(Boolean);
  }

  function syncFilterUrl(query: string, selectedTags: Set<string>) {
    const url = new URL(window.location.href);
    if (query) {
      url.searchParams.set('q', query);
    } else {
      url.searchParams.delete('q');
    }

    if (selectedTags.size > 0) {
      url.searchParams.set('tags', Array.from(selectedTags).join(','));
    } else {
      url.searchParams.delete('tags');
    }

    window.history.replaceState({}, '', `${url.pathname}${url.search}`);
  }

  function initArticleTagFilter() {
    if (articleFilterAbort) articleFilterAbort.abort();
    articleFilterAbort = new AbortController();
    const { signal } = articleFilterAbort;

    const filterRoot = document.querySelector<HTMLElement>('[data-role="article-tag-filter"]');
    if (!filterRoot) return;

    const buttons = Array.from(filterRoot.querySelectorAll<HTMLButtonElement>('.tag-filter-btn[data-tag-filter]'));
    const status = filterRoot.querySelector<HTMLElement>('[data-role="tag-filter-status"]');
    const clearTagButton = filterRoot.querySelector<HTMLButtonElement>('[data-role="tag-filter-clear"]');
    const searchInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-role="search-input"]'));
    const searchClears = Array.from(document.querySelectorAll<HTMLElement>('[data-role="search-clear"]'));
    const searchStatuses = Array.from(document.querySelectorAll<HTMLElement>('[data-role="search-status"]'));
    const articles = Array.from(document.querySelectorAll<HTMLElement>('.article-card[data-filter-tags]'));
    const yearSections = Array.from(document.querySelectorAll<HTMLElement>('.year-section'));
    const featuredSection = document.querySelector<HTMLElement>('[data-section="featured"]');
    const totalCount = articles.length;
    const selectedTags = new Set<string>();

    const params = new URLSearchParams(window.location.search);
    let query = (params.get('q') ?? '').trim();
    const urlTags = parseTags(params.get('tags'));
    urlTags.forEach((tag) => selectedTags.add(tag));

    const syncSearchUi = () => {
      searchInputs.forEach((input) => {
        if (input.value !== query) input.value = query;
      });
      searchClears.forEach((btn) => btn.classList.toggle('hidden', !query));
    };

    const applyFilter = () => {
      const lowerQuery = query.toLowerCase();
      let visibleCount = 0;

      articles.forEach((article) => {
        const articleTags = parseTags(article.getAttribute('data-filter-tags'));
        const tagMatched = selectedTags.size === 0 || articleTags.some((tag) => selectedTags.has(tag));
        const textMatched = !lowerQuery || (article.textContent ?? '').toLowerCase().includes(lowerQuery);
        const isVisible = tagMatched && textMatched;

        article.classList.toggle('hidden', !isVisible);
        if (isVisible) visibleCount += 1;
      });

      buttons.forEach((button) => {
        const tag = button.getAttribute('data-tag-filter');
        const isAll = tag === 'all';
        const isActive = isAll ? selectedTags.size === 0 : (tag ? selectedTags.has(tag) : false);
        button.classList.toggle('active', isActive);
      });

      if (featuredSection) {
        const visibleFeatured = featuredSection.querySelectorAll('.article-card:not(.hidden)');
        featuredSection.classList.toggle('hidden', visibleFeatured.length === 0);
      }

      yearSections.forEach((section) => {
        const visibleArticles = section.querySelectorAll('.article-card:not(.hidden)');
        section.classList.toggle('hidden', visibleArticles.length === 0);
      });

      if (status) {
        if (!query && selectedTags.size === 0) {
          status.textContent = `显示全部 ${totalCount} 篇文章`;
        } else if (query && selectedTags.size === 0) {
          status.textContent = `搜索“${query}” · ${visibleCount} / ${totalCount} 篇`;
        } else if (!query && selectedTags.size > 0) {
          const labels = Array.from(selectedTags).join('、');
          status.textContent = `标签筛选 · ${visibleCount} / ${totalCount} 篇 · ${labels}`;
        } else {
          const labels = Array.from(selectedTags).join('、');
          status.textContent = `搜索 + 标签 · ${visibleCount} / ${totalCount} 篇 · ${labels}`;
        }
      }

      searchStatuses.forEach((searchStatus) => {
        if (!query) {
          searchStatus.classList.add('hidden');
          return;
        }
        searchStatus.textContent = `找到 ${visibleCount} 篇结果`;
        searchStatus.classList.remove('hidden');
      });

      if (clearTagButton) {
        clearTagButton.classList.toggle('hidden', selectedTags.size === 0);
      }

      syncSearchUi();
      syncFilterUrl(query, selectedTags);
    };

    buttons.forEach((button) => {
      button.addEventListener(
        'click',
        () => {
          const tag = button.getAttribute('data-tag-filter');
          if (!tag) return;

          if (tag === 'all') {
            selectedTags.clear();
          } else if (selectedTags.has(tag)) {
            selectedTags.delete(tag);
          } else {
            selectedTags.add(tag);
          }

          applyFilter();
        },
        { signal }
      );
    });

    clearTagButton?.addEventListener(
      'click',
      () => {
        selectedTags.clear();
        applyFilter();
      },
      { signal }
    );

    searchInputs.forEach((input) => {
      input.addEventListener(
        'input',
        (event) => {
          query = (event.target as HTMLInputElement).value.trim();
          applyFilter();
        },
        { signal }
      );

      input.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape') {
            query = '';
            applyFilter();
          }
        },
        { signal }
      );
    });

    searchClears.forEach((btn) => {
      btn.addEventListener(
        'click',
        () => {
          query = '';
          applyFilter();
          const firstVisible = searchInputs.find((input) => input.offsetParent !== null);
          if (firstVisible) firstVisible.focus();
        },
        { signal }
      );
    });

    applyFilter();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArticleTagFilter);
  } else {
    initArticleTagFilter();
  }

  document.addEventListener('astro:page-load', initArticleTagFilter);
