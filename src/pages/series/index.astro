---
// src/pages/series/index.astro - 系列总览页（编辑部风格）
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import UnifiedSidebar from '../../components/UnifiedSidebar.astro';
import Footer from '../../components/Footer.astro';
import { seriesList } from '../../data/series';

const pageTitle = 'Series - TechArt Chronicle';
const description = '系列笔记合集 - GAMES101 图形学、GAMES104 游戏引擎、InsideUE4 源码分析等系列文章。';
---

<BaseLayout title={pageTitle} description={description}>
  <Header title="Series" subPage subtitle="Long-form reading paths. These collections are arranged from fundamentals to implementation details." />

  <div class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <UnifiedSidebar currentSection="series" showSearch={false} showProfile={false} />

      <main class="lg:col-span-9 relative pl-0 lg:pl-12 space-y-12">
        <section class="blur-load rounded-[2rem] border border-ink/10 bg-white/80 p-6 md:p-8 shadow-[0_18px_48px_rgba(26,26,26,0.06)]">
          <div class="grid gap-8 lg:grid-cols-[1.2fr,0.8fr] lg:items-center">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">Collections / Series</p>
              <h1 class="mt-3 font-serif text-4xl md:text-5xl xl:text-6xl leading-[0.95] text-ink">
                按路线阅读，而不是按碎片跳读
              </h1>
              <p class="mt-4 max-w-3xl text-sm md:text-base leading-7 text-gray-600">
                这些系列页像一组知识路线图，适合从头到尾连续阅读，也适合按章节回查。
              </p>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
              <div class="rounded-[1.5rem] border border-ink/10 bg-paper p-5">
                <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400">Series</div>
                <div class="mt-2 font-serif text-3xl text-ink">{seriesList.length}</div>
                <div class="mt-2 text-sm leading-6 text-gray-600">个长期系列</div>
              </div>
              <div class="rounded-[1.5rem] border border-ink/10 bg-paper p-5">
                <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400">Chapters</div>
                <div class="mt-2 font-serif text-3xl text-ink">{seriesList.reduce((sum, series) => sum + series.articles.length, 0)}</div>
                <div class="mt-2 text-sm leading-6 text-gray-600">章可连续浏览</div>
              </div>
            </div>
          </div>
        </section>

        <section class="space-y-5">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">Series Map</p>
            <h2 class="mt-2 font-serif text-3xl text-ink">每个系列的定位</h2>
          </div>

          <div class="grid gap-6">
            {seriesList.map((series, index) => (
              <article class="rounded-[1.75rem] border border-ink/10 bg-white/80 p-6 md:p-8 shadow-[0_14px_34px_rgba(26,26,26,0.05)] transition-all duration-300 hover:-translate-y-1 hover:border-ochre hover:shadow-[0_18px_42px_rgba(138,98,64,0.12)]">
                <div class="grid gap-6 lg:grid-cols-[1.1fr,0.9fr]">
                  <div>
                    <div class="flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.3em]">
                      <span class="rounded-full bg-forest/10 px-2.5 py-1 text-forest">{series.category}</span>
                      <span class="rounded-full bg-gray-100 px-2.5 py-1 text-gray-600">{series.articles.length} 篇</span>
                    </div>
                    <h3 class="mt-4 font-serif text-3xl leading-tight text-ink">
                      {series.title}
                    </h3>
                    <p class="mt-3 text-xs uppercase tracking-[0.3em] text-gray-400">{series.titleEn}</p>
                    <p class="mt-4 max-w-2xl text-sm leading-7 text-gray-600">
                      {series.description}
                    </p>

                    <div class="mt-5 flex flex-wrap gap-2">
                      {series.tags.map((tag) => (
                        <span class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-600">{tag}</span>
                      ))}
                    </div>

                    <div class="mt-6">
                      <a
                        href={`/articles/${series.id}/`}
                        class="inline-flex items-center justify-center rounded-full bg-forest px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-forest/90"
                      >
                        进入系列 →
                      </a>
                    </div>
                  </div>

                  <div class="rounded-[1.5rem] border border-ink/10 bg-paper p-5">
                    <div class="flex items-center justify-between">
                      <h4 class="font-serif text-xl text-ink">目录预览</h4>
                      <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400">Preview</span>
                    </div>
                    <div class="mt-4 space-y-3">
                      {series.articles.slice(0, 4).map((article) => (
                        <a
                          href={`/articles/${article.slug}/`}
                          class="group flex items-start gap-3 rounded-2xl border border-ink/10 bg-white px-4 py-3 transition-all duration-300 hover:-translate-y-0.5 hover:border-ochre hover:shadow-[0_10px_24px_rgba(138,98,64,0.10)]"
                        >
                          <span class="min-w-12 text-xs font-bold uppercase tracking-[0.25em] text-ochre">
                            {article.chapter ?? 'Ch'}
                          </span>
                          <div class="min-w-0">
                            <div class="text-sm font-semibold text-ink group-hover:text-forest transition-colors line-clamp-1">
                              {article.title}
                            </div>
                            <div class="mt-1 text-xs text-gray-400">{article.date}</div>
                          </div>
                        </a>
                      ))}
                      {series.articles.length > 4 && (
                        <div class="rounded-2xl border border-dashed border-ink/10 px-4 py-3 text-xs text-gray-500">
                          还有 {series.articles.length - 4} 章未展开
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <div class="mt-20 border-t border-gray-300 pt-8 flex justify-between items-center text-sm font-serif italic text-gray-500">
          <span>{seriesList.length} 个系列</span>
          <a href="#top" class="text-ochre hover:underline">Back to Top ↑</a>
        </div>
      </main>
    </div>
  </div>

  <Footer />
</BaseLayout>
