---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import { formatDateCN } from '../utils/date';
import { mapArticleEntry, sortByDateDesc, uniqueArticlesByTitle } from '../utils/content';

const articles = uniqueArticlesByTitle(sortByDateDesc(
  (await getCollection('articles')).filter((entry) => entry.data.listed !== false).map(mapArticleEntry)
));
---

<BaseLayout title="TechArt Chronicle | 技术美术志" description="YKMON 的技术美术笔记，记录 Unreal Engine、Houdini、Shader 与自动化管线的实践。">
  <TopNav currentSection="home" />
  <main class="reading-width home-main">
    <section class="home-intro">
      <h1>YKMON</h1>
      <p>技术美术、工具开发与游戏制作</p>
      <p>记录可以复用的方法，整理引擎、程序化流程和图形学实践中的思考。</p>
      <div class="home-links">
        <a href="/about/">关于我</a><span>·</span>
        <a href="/series/">系列笔记</a><span>·</span>
        <a href="/tools/">工具库</a><span>·</span>
        <a href="https://space.bilibili.com/18272055" target="_blank" rel="noopener noreferrer">Bilibili</a>
      </div>
    </section>
    <section class="home-articles" aria-labelledby="recent-title">
      <div class="section-heading">
        <h2 id="recent-title">最近文章</h2>
        <a href="/articles/">全部文章 →</a>
      </div>
      <div class="reading-list">
        {articles.slice(0, 12).map((article) => (
          <article class="reading-list-item">
            <div class="reading-list-title">
              <h3><a href={article.href}>{article.title}</a></h3>
              <time datetime={article.date}>{formatDateCN(article.date, true)}</time>
            </div>
            <p>{article.description}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
