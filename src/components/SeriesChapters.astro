---
// SeriesChapters.astro - 统一系列章节的文字目录
export interface Props {
  basePath: string;
  articles: Array<{ href: string; title: string; desc: string }>;
}
const { basePath, articles } = Astro.props;
---

<ol class="not-prose reading-list" aria-label="系列章节">
  {articles.map((article, index) => (
    <li class="flex gap-4 sm:gap-6">
      <span class="shrink-0 whitespace-nowrap pt-1 text-sm tabular-nums text-gray-400" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <div class="reading-list-item min-w-0">
        <h2 class="text-xl"><a class="text-link" href={`${basePath}/${article.href}/`}>{article.title}</a></h2>
        <p>{article.desc}</p>
      </div>
    </li>
  ))}
</ol>
