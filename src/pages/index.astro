---
// src/pages/index.astro - 首页（编辑部封面版）
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import { seriesList } from '../data/series';
import { videos } from '../data/content';
import { formatDateCN } from '../utils/date';
import { mapArticleEntry, mapGalleryEntry, mapToolEntry, sortByDateDesc, uniqueArticlesByTitle } from '../utils/content';

const pageTitle = 'TechArt Chronicle | 技术美术志';
const description = '技术美术博客 - 分享 Unreal Engine、Houdini、Shader、PCG、自动化管线等实践笔记。';

const collectionArticles = sortByDateDesc(
  (await getCollection('articles')).filter((entry) => entry.data.listed !== false).map(mapArticleEntry)
);
const tools = sortByDateDesc((await getCollection('tools')).map(mapToolEntry));
const galleryPhotos = sortByDateDesc(
  (await getCollection('gallery')).filter((entry) => entry.data.listed !== false).map(mapGalleryEntry)
);
const uniqueArticles = uniqueArticlesByTitle(collectionArticles);

const featuredArticles = uniqueArticles.slice(0, 5);
const latestArticles = uniqueArticles.slice(0, 8);

const heroStats = [
  { label: 'Articles', value: `${collectionArticles.length}` },
  { label: 'Series', value: `${seriesList.length}` },
  { label: 'Tools', value: `${tools.length}` },
  { label: 'Videos', value: `${videos.length}` },
  { label: 'Photos', value: `${galleryPhotos.length}` },
];

const topicCards = [
  {
    label: 'Unreal Engine',
    description: '渲染、蓝图、插件与项目实践。',
    href: '/articles/?q=Unreal%20Engine',
    query: 'Unreal Engine',
    accent: 'forest',
  },
  {
    label: 'Houdini',
    description: '节点式流程、HDA、Python 与程序化工具。',
    href: '/articles/?q=Houdini',
    query: 'Houdini',
    accent: 'ochre',
  },
  {
    label: 'Shader',
    description: '材质、光照、着色器与实时效果。',
    href: '/articles/?q=Shader',
    query: 'Shader',
    accent: 'forest',
  },
  {
    label: 'Graphics',
    description: '渲染管线、光栅化、矩阵与基础图形学。',
    href: '/articles/?q=渲染',
    query: '渲染',
    accent: 'ochre',
  },
  {
    label: 'PCG',
    description: '程序化生成、场景构建与自动化思路。',
    href: '/articles/?q=PCG',
    query: 'PCG',
    accent: 'forest',
  },
  {
    label: 'Tools / DevOps',
    description: '脚本、插件、流水线和工程化整理。',
    href: '/tools/',
    query: 'Library',
    accent: 'ochre',
  },
  {
    label: 'Gallery',
    description: '风景、扫街与日常观察的影像记录。',
    href: '/gallery/',
    query: 'Photos',
    accent: 'forest',
  },
];

const latestUpdate = latestArticles[0]?.date ? formatDateCN(latestArticles[0].date) : '';
---

<BaseLayout title={pageTitle} description={description}>
  <TopNav currentSection="home" />

  <div class="container mx-auto px-4 md:px-6 py-10 md:py-12 max-w-7xl">
    <main class="space-y-12">
          <section class="relative overflow-hidden rounded-[2rem] border border-ink/10 bg-[linear-gradient(180deg,rgba(255,255,255,0.82),rgba(245,245,247,0.98))] p-6 md:p-8 shadow-[0_18px_50px_rgba(26,26,26,0.06)]">
            <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-ochre/10 blur-3xl"></div>
            <div class="absolute -bottom-24 left-1/3 h-72 w-72 rounded-full bg-forest/10 blur-3xl"></div>
            <div class="relative grid gap-8 lg:grid-cols-12 lg:items-center">
              <div class="lg:col-span-7">
                <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">Issue 01 / Editorial Home</p>
                <h1 class="mt-4 max-w-xl font-serif text-5xl leading-[0.92] text-ink md:text-6xl xl:text-7xl">
                  记录技术美术的思考与实践
                </h1>
                <p class="mt-5 max-w-2xl text-sm leading-7 text-gray-600 md:text-base">
                  围绕 Unreal Engine、Houdini、Shader、PCG、自动化与游戏开发管线的长期笔记。
                  这里不是一个简单目录，而是一份持续更新的工作手册。
                </p>

                <div class="mt-7 flex flex-wrap gap-3">
                  <a
                    href="/articles/"
                    class="inline-flex items-center justify-center rounded-full bg-forest px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-forest/90"
                  >
                    浏览文章
                  </a>
                  <a
                    href="/series/"
                    class="inline-flex items-center justify-center rounded-full border border-ink/15 bg-white/80 px-5 py-2.5 text-sm font-semibold text-ink transition-all duration-300 hover:-translate-y-0.5 hover:border-ochre hover:text-ochre"
                  >
                    查看系列
                  </a>
                  <a
                    href="/about/"
                    class="inline-flex items-center justify-center rounded-full px-5 py-2.5 text-sm font-semibold text-gray-500 transition-colors hover:text-ochre"
                  >
                    关于本站 →
                  </a>
                </div>

                <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-5">
                  {heroStats.map((stat) => (
                    <div class="rounded-2xl border border-ink/10 bg-white/70 px-4 py-3 backdrop-blur-sm">
                      <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400">{stat.label}</div>
                      <div class="mt-2 font-serif text-2xl text-ink">{stat.value}</div>
                    </div>
                  ))}
                </div>
              </div>

              <div class="lg:col-span-5">
                <div class="rounded-[1.75rem] border border-ink/10 bg-white/75 p-4 shadow-[0_20px_40px_rgba(26,26,26,0.05)] backdrop-blur-sm">
                  <div class="rounded-[1.25rem] border border-ink/10 bg-[radial-gradient(circle_at_top_left,rgba(45,74,62,0.18),transparent_42%),linear-gradient(180deg,rgba(26,26,26,0.96),rgba(45,74,62,0.92))] p-5 text-paper">
                    <p class="text-[10px] font-bold uppercase tracking-[0.35em] text-paper/65">Now Editing</p>
                    <h2 class="mt-3 font-serif text-3xl leading-tight">
                      知识索引
                    </h2>
                  </div>

                  <div class="mt-4 grid gap-3">
                    <a href={`/articles/${seriesList[2].id}/`} class="group rounded-2xl border border-ink/10 bg-paper px-4 py-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-ochre">
                      <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400">Latest Series</div>
                      <div class="mt-2 font-serif text-lg text-ink group-hover:text-forest">{seriesList[2].title}</div>
                      <p class="mt-2 text-sm leading-6 text-gray-600">{seriesList[2].description}</p>
                    </a>

                    <a href="/tools/" class="group rounded-2xl border border-ink/10 bg-paper px-4 py-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-ochre">
                      <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400">Toolbox</div>
                      <div class="mt-2 font-serif text-lg text-ink group-hover:text-forest">{tools.length} 个工具条目</div>
                      <p class="mt-2 text-sm leading-6 text-gray-600">
                        Houdini 脚本、HDA 相关笔记与可复用小工具。
                      </p>
                    </a>

                    <div class="rounded-2xl border border-ink/10 bg-paper px-4 py-4">
                      <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400">Recent Update</div>
                      <div class="mt-2 font-serif text-lg text-ink">{latestUpdate || 'Awaiting update'}</div>
                      <p class="mt-2 text-sm leading-6 text-gray-600">
                        最新内容会优先出现在首页首屏和最近更新列表里。
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="blur-load space-y-5">
            <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">精选内容 Featured</p>
                <h2 class="mt-2 font-serif text-3xl text-ink">优先阅读的文章</h2>
                <p class="mt-2 max-w-2xl text-sm leading-7 text-gray-600">
                  这里放最近更新且最值得先看的几篇文章，作为首页的内容入口。
                </p>
              </div>
              <a href="/articles/" class="text-sm font-semibold text-gray-500 transition-colors hover:text-ochre">
                查看全部文章 →
              </a>
            </div>

            <div class="grid gap-5 lg:grid-cols-12">
              <div class="grid gap-5 lg:col-span-7">
                {featuredArticles.slice(0, 2).map((article, index) => (
                <a
                  href={article.href}
                  class="group overflow-hidden rounded-[1.75rem] border border-ink/10 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-ochre hover:shadow-[0_18px_42px_rgba(138,98,64,0.14)]"
                >
                  <div class="relative aspect-video overflow-hidden bg-forest">
                    {article.image ? (
                      <img
                        loading="lazy"
                        decoding="async"
                        src={article.image}
                        alt={article.imageAlt ?? article.title}
                        class="h-full w-full object-contain"
                      />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.12),transparent_35%),linear-gradient(135deg,#2d4a3e,#1a1a1a)] px-8 text-center font-serif text-3xl text-paper">
                        {article.category}
                      </div>
                    )}
                    <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-ink/80 to-transparent"></div>
                    <div class="absolute left-5 top-5 rounded-full bg-paper/90 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.3em] text-forest backdrop-blur">
                      Featured {String(index + 1).padStart(2, '0')}
                    </div>
                  </div>
                  <div class="p-5 md:p-6">
                    <div class="flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.28em]">
                      <span class="rounded-full bg-forest/10 px-2.5 py-1 text-forest">{article.category}</span>
                      {article.readTime && <span class="text-gray-400">{article.readTime}</span>}
                      <span class="text-gray-300">•</span>
                      <span class="text-gray-400">{formatDateCN(article.date)}</span>
                    </div>
                    <h3 class="mt-3 font-serif text-2xl leading-tight text-ink transition-colors group-hover:text-forest">
                      {article.title}
                    </h3>
                    <p class="mt-2 line-clamp-2 max-w-2xl text-sm leading-6 text-gray-600 md:text-base">
                      {article.description}
                    </p>
                    <div class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-ochre">
                      阅读这篇文章 <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                    </div>
                  </div>
                </a>
                ))}
              </div>

              <div class="grid gap-5 lg:col-span-5">
                {featuredArticles.slice(2, 5).map((article, index) => (
                  <a
                    href={article.href}
                    class="group h-full overflow-hidden rounded-[1.5rem] border border-ink/10 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-ochre hover:shadow-[0_18px_42px_rgba(138,98,64,0.14)]"
                  >
                    <div class="grid h-full gap-0">
                      <div class="aspect-video overflow-hidden bg-forest">
                        {article.image ? (
                          <img
                            loading="lazy"
                            decoding="async"
                            src={article.image}
                            alt={article.imageAlt ?? article.title}
                            class="h-full w-full object-contain"
                          />
                        ) : (
                          <div class="flex h-full w-full items-center justify-center bg-[linear-gradient(135deg,#2d4a3e,#8a6240)] font-serif text-2xl text-paper">
                            {article.category.slice(0, 1)}
                          </div>
                        )}
                      </div>
                      <div class="flex min-w-0 flex-col p-4 md:p-5">
                        <div class="flex min-w-0 flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.28em]">
                          <span class="rounded-full bg-ochre/10 px-2.5 py-1 text-ochre">{String(index + 3).padStart(2, '0')}</span>
                          <span class="rounded-full bg-gray-100 px-2.5 py-1 text-gray-600">{article.category}</span>
                          {article.readTime && <span class="text-gray-400">{article.readTime}</span>}
                        </div>
                        <h3 class="mt-3 line-clamp-2 font-serif text-xl leading-tight text-ink transition-colors group-hover:text-forest">
                          {article.title}
                        </h3>
                        <p class="mt-2 line-clamp-2 text-sm leading-6 text-gray-600">
                          {article.description}
                        </p>
                        <div class="mt-3 text-xs font-semibold uppercase tracking-[0.25em] text-gray-400">
                          {formatDateCN(article.date)}
                        </div>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </section>

          <section class="blur-load space-y-5">
            <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">系列笔记 Series</p>
                <h2 class="mt-2 font-serif text-3xl text-ink">按路线阅读</h2>
                <p class="mt-2 max-w-2xl text-sm leading-7 text-gray-600">
                  系列页适合连续阅读，首页只保留最重要的三个入口。
                </p>
              </div>
              <a href="/series/" class="text-sm font-semibold text-gray-500 transition-colors hover:text-ochre">
                查看系列总览 →
              </a>
            </div>

            <div class="grid gap-5 lg:grid-cols-3">
              {seriesList.map((series) => (
                <a
                  href={`/articles/${series.id}/`}
                  class="group relative overflow-hidden rounded-[1.5rem] border border-ink/10 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-ochre hover:shadow-[0_18px_42px_rgba(45,74,62,0.12)]"
                >
                  <div class="absolute right-0 top-0 h-28 w-28 rounded-full bg-forest/5 blur-2xl"></div>
                  <div class="relative">
                    <div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400">
                      <span class="rounded-full bg-forest/10 px-2.5 py-1 text-forest">{series.category}</span>
                      <span>{series.articles.length} 篇</span>
                    </div>
                    <h3 class="mt-4 font-serif text-2xl leading-tight text-ink transition-colors group-hover:text-forest">
                      {series.title}
                    </h3>
                    <p class="mt-3 text-sm leading-7 text-gray-600">
                      {series.description}
                    </p>

                    <div class="mt-5 space-y-2">
                      {series.articles.slice(0, 3).map((article) => (
                        <div class="flex items-center gap-3 text-sm text-gray-500">
                          <span class="min-w-12 font-mono text-[11px] uppercase tracking-[0.2em] text-ochre">
                            {article.chapter ?? 'Ch'}
                          </span>
                          <span class="truncate">{article.title}</span>
                        </div>
                      ))}
                    </div>

                    <div class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-ochre">
                      进入系列 <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>

          <section class="blur-load space-y-5">
            <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">按主题浏览 Topic Hub</p>
                <h2 class="mt-2 font-serif text-3xl text-ink">从主题入口快速进入</h2>
                <p class="mt-2 max-w-2xl text-sm leading-7 text-gray-600">
                  这些入口会直接带你去文章筛选结果，适合按兴趣快速跳转。
                </p>
              </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
              {topicCards.map((topic) => (
                <a
                  href={topic.href}
                  class:list={[
                    'group rounded-[1.35rem] border p-5 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_16px_35px_rgba(26,26,26,0.06)]',
                    topic.accent === 'forest'
                      ? 'border-forest/10 bg-[linear-gradient(180deg,rgba(45,74,62,0.05),rgba(255,255,255,0.85))] hover:border-forest/25'
                      : 'border-ochre/10 bg-[linear-gradient(180deg,rgba(138,98,64,0.06),rgba(255,255,255,0.85))] hover:border-ochre/25',
                  ]}
                >
                  <div class="flex items-center justify-between gap-4">
                    <div>
                      <div class:list={[
                        'text-[10px] font-bold uppercase tracking-[0.3em]',
                        topic.accent === 'forest' ? 'text-forest' : 'text-ochre',
                      ]}>
                        {topic.query}
                      </div>
                      <h3 class="mt-3 font-serif text-2xl text-ink transition-colors group-hover:text-forest">
                        {topic.label}
                      </h3>
                    </div>
                    <span class:list={[
                      'text-2xl transition-transform duration-300 group-hover:translate-x-1',
                      topic.accent === 'forest' ? 'text-forest/30' : 'text-ochre/30',
                    ]}>
                      ↗
                    </span>
                  </div>
                  <p class="mt-4 text-sm leading-7 text-gray-600">
                    {topic.description}
                  </p>
                </a>
              ))}
            </div>
          </section>

          <section class="blur-load space-y-5">
            <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">最近更新 Latest</p>
                <h2 class="mt-2 font-serif text-3xl text-ink">最近写了什么</h2>
                <p class="mt-2 max-w-2xl text-sm leading-7 text-gray-600">
                  首页默认展示最近更新的 8 篇内容，方便快速跟进新笔记。
                </p>
              </div>
              <div class="text-sm text-gray-500">
                {latestArticles.length} 条更新 · 最近一次更新 {latestUpdate || '暂无'}
              </div>
            </div>

            <div class="grid gap-4 xl:grid-cols-2">
              {latestArticles.map((article, index) => (
                <a
                  href={article.href}
                  class="group grid gap-4 rounded-[1.35rem] border border-ink/10 bg-white/85 p-4 transition-all duration-300 hover:-translate-y-1 hover:border-ochre hover:shadow-[0_14px_32px_rgba(138,98,64,0.12)] md:grid-cols-[140px,minmax(0,1fr),auto] md:items-center md:p-5"
                >
                  <div class="overflow-hidden rounded-[1.15rem] border border-ink/10 bg-forest">
                    {article.image ? (
                      <img
                        loading="lazy"
                        decoding="async"
                        src={article.image}
                        alt={article.imageAlt ?? article.title}
                        class="h-40 w-full object-cover transition-transform duration-700 group-hover:scale-105 md:h-full"
                      />
                    ) : (
                      <div class="flex h-40 w-full items-center justify-center bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.12),transparent_35%),linear-gradient(135deg,#2d4a3e,#1a1a1a)] px-4 text-center font-serif text-2xl text-paper md:h-full">
                        {article.placeholder ?? article.category}
                      </div>
                    )}
                  </div>

                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.25em]">
                      <span class="text-ochre">{String(index + 1).padStart(2, '0')}</span>
                      <span class="hidden h-4 w-px bg-gray-200 md:block"></span>
                      <span class="rounded-full bg-forest/10 px-2.5 py-1 text-forest">{article.category}</span>
                      {article.readTime && <span class="text-gray-400">{article.readTime}</span>}
                    </div>
                    <h3 class="mt-3 font-serif text-xl leading-tight text-ink transition-colors group-hover:text-forest">
                      {article.title}
                    </h3>
                    <p class="mt-2 text-sm leading-6 text-gray-600 line-clamp-2">
                      {article.description}
                    </p>
                  </div>

                  <div class="flex items-center justify-between gap-4 text-sm text-gray-400 md:min-w-36 md:flex-col md:items-end md:justify-center">
                    <span>{formatDateCN(article.date)}</span>
                    <span class="font-semibold text-ochre transition-transform duration-300 group-hover:translate-x-1 md:translate-x-0">
                      →
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </section>

          <section class="blur-load">
            <div class="overflow-hidden rounded-[2rem] border border-ink/10 bg-ink text-paper shadow-[0_18px_50px_rgba(26,26,26,0.12)]">
              <div class="grid gap-6 p-6 md:p-8 lg:grid-cols-[auto,1fr,auto] lg:items-center">
                <div class="flex justify-center lg:justify-start">
                  <div class="h-20 w-20 overflow-hidden rounded-full border border-paper/20">
                    <img
                      loading="lazy"
                      decoding="async"
                      src="/Resource/ykmon.jpg"
                      alt="YKMON"
                      class="h-full w-full object-cover"
                    />
                  </div>
                </div>

                <div class="text-center lg:text-left">
                  <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-paper/55">About this site</p>
                  <h2 class="mt-3 font-serif text-2xl leading-tight md:text-3xl">
                    记录可以复用的方法，而不是零散灵感
                  </h2>
                  <p class="mt-3 max-w-2xl text-sm leading-7 text-paper/75">
                    这里持续整理 Unreal Engine、Houdini、Shader、工具链与游戏开发中的实践笔记，
                    重点放在可复用的流程、实现细节和问题解决思路。
                  </p>
                </div>

                <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
                  <a
                    href="/about/"
                    class="inline-flex items-center justify-center rounded-full bg-paper px-5 py-2.5 text-sm font-semibold text-ink transition-all duration-300 hover:-translate-y-0.5 hover:bg-paper/90"
                  >
                    了解更多
                  </a>
                  <a
                    href="/articles/"
                    class="inline-flex items-center justify-center rounded-full border border-paper/20 px-5 py-2.5 text-sm font-semibold text-paper transition-all duration-300 hover:-translate-y-0.5 hover:border-paper/35 hover:bg-paper/5"
                  >
                    进入文章库
                  </a>
                </div>
              </div>
              <div class="h-1 bg-gradient-to-r from-forest via-ochre to-forest"></div>
            </div>
          </section>
