---
// index.astro - 首页
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';

const pageTitle = 'TechArt Chronicle | 技术美术志';
const subtitle = '不要温和地走入那良夜。<br>Do not go gentle into that good night.';
---

<BaseLayout title={pageTitle}>
  <Header title="TechArt Chronicle." subtitle={subtitle} />
  
  <div class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <Sidebar currentSection="home" />
      
      <!-- MAIN CONTENT -->
      <main class="lg:col-span-9 relative pl-0 lg:pl-12">
        <div class="timeline-line hidden lg:block"></div>
        
        <div id="timeline-container">
          
          <!-- Entry: MIT 18.06 -->
          <article class="relative mb-20 md:grid md:grid-cols-12 gap-8 items-start blur-load group scroll-mt-24">
            <div class="hidden lg:block absolute left-8 top-0 -translate-x-[calc(50%+1px)] bg-paper py-1 text-xs font-bold text-ochre border border-gray-300 z-10 w-fit px-2">
              12月23日
            </div>
            <div class="md:col-span-12 lg:col-span-12">
              <div class="flex flex-col mb-4">
                <span class="text-ochre font-bold text-xs tracking-wider uppercase mb-2">No. --- — Linear Algebra</span>
                <a href="/articles/mit18-06/" class="block">
                  <h2 class="font-serif text-3xl md:text-5xl font-bold leading-tight text-ink group-hover:text-forest transition-colors cursor-pointer">
                    MIT 18.06 线性代数笔记 - 第一讲
                  </h2>
                </a>
              </div>
              <div class="grid md:grid-cols-2 gap-8 relative z-20">
                <div class="font-body text-gray-700 leading-relaxed text-lg text-justify">
                  <a href="/articles/mit18-06/" class="block hover:text-ink transition-colors">
                    <p class="drop-cap">方程组的几何解释：从 Row Picture 到 Column Picture。了解矩阵乘法的本质。</p>
                  </a>
                </div>
                <div class="relative pt-2">
                  <a href="/articles/mit18-06/" class="block aspect-[4/3] bg-gray-200 overflow-hidden rounded-sm shadow-md">
                    <img src="/Articles/MIT18.06/images/row_picture.png" class="object-cover w-full h-full hover:scale-105 transition-transform duration-700 grayscale-[0.2]" alt="MIT 18.06 线性代数笔记">
                  </a>
                  <div class="mt-4 flex justify-between items-center border-t border-gray-300 pt-3">
                    <span class="text-xs text-gray-500 uppercase tracking-widest">Dec 23, 2025 • 10 Min Read</span>
                    <a href="/articles/mit18-06/" class="text-sm text-ochre italic font-serif hover:underline">Read Full Article ⟶</a>
                  </div>
                </div>
              </div>
            </div>
          </article>
          <hr class="border-gray-200 mb-20 w-1/2 mx-auto">
          
          <!-- Entry: Video PCG -->
          <article class="relative mb-20 blur-load scroll-mt-24">
            <div class="hidden lg:block absolute left-8 top-0 -translate-x-[calc(50%+1px)] bg-paper py-1 text-xs font-bold text-ochre border border-gray-300 z-10 w-fit px-2">
              2月5日
            </div>
            <div class="max-w-4xl mx-auto">
              <div class="bg-white p-3 retro-frame transform hover:-translate-y-1 transition-transform duration-500">
                <div class="aspect-video bg-gray-800 relative overflow-hidden group">
                  <iframe src="https://player.bilibili.com/player.html?isOutside=true&aid=113946639995417&bvid=BV1qfPze6ExY&cid=28217575778&p=1&autoplay=0" class="w-full h-full absolute inset-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
                <div class="p-6 flex justify-between items-end">
                  <div>
                    <h3 class="font-serif text-2xl font-bold italic mb-1">程序化生成场景 PCG Landscape</h3>
                    <p class="text-xs text-gray-500 uppercase tracking-widest">Level Design / PCG</p>
                  </div>
                  <div class="text-ochre">◎ Bilibili</div>
                </div>
              </div>
            </div>
          </article>
          <hr class="border-gray-200 mb-20 w-1/2 mx-auto">
          
          <!-- Entry: Video Cloth -->
          <article class="relative mb-20 blur-load scroll-mt-24">
            <div class="hidden lg:block absolute left-8 top-0 -translate-x-[calc(50%+1px)] bg-paper py-1 text-xs font-bold text-ochre border border-gray-300 z-10 w-fit px-2">
              12月10日
            </div>
            <div class="max-w-4xl mx-auto">
              <div class="bg-white p-3 retro-frame transform hover:-translate-y-1 transition-transform duration-500">
                <div class="aspect-video bg-gray-800 relative overflow-hidden group">
                  <iframe src="https://player.bilibili.com/player.html?isOutside=true&aid=113622856505513&bvid=BV14EqNYdEF4&cid=27259832910&p=1&autoplay=0" class="w-full h-full absolute inset-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
                <div class="p-6 flex justify-between items-end">
                  <div>
                    <h3 class="font-serif text-2xl font-bold italic mb-1">自动化布料解算 Automate Cloth Solver Pipeline</h3>
                    <p class="text-xs text-gray-500 uppercase tracking-widest">Procedural / CFX</p>
                  </div>
                  <div class="text-ochre">◎ Bilibili</div>
                </div>
              </div>
            </div>
          </article>
          <hr class="border-gray-200 mb-20 w-1/2 mx-auto">
          
          <!-- Tool Entries -->
          <article class="relative mb-20 md:grid md:grid-cols-12 gap-8 items-center blur-load group scroll-mt-24">
            <div class="hidden lg:block absolute left-8 top-0 -translate-x-[calc(50%+1px)] bg-paper py-1 text-xs font-bold text-ochre border border-gray-300 z-10 w-fit px-2">
              12月10日
            </div>
            <div class="col-span-12 max-w-3xl mx-auto w-full">
              <a href="/tools/node-input-count/" class="block bg-white border border-gray-200 p-8 hover:border-ochre transition-all hover:shadow-lg group-hover:-translate-y-1">
                <div class="flex items-start gap-6">
                  <div class="text-4xl text-ochre">🔢</div>
                  <div>
                    <div class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">New Tool Released</div>
                    <h3 class="font-serif text-2xl font-bold text-ink mb-2 group-hover:text-ochre transition-colors">节点输入数量</h3>
                    <p class="text-gray-600 italic font-serif">Managing node input connections util</p>
                  </div>
                </div>
              </a>
            </div>
          </article>
          <hr class="border-gray-200 mb-20 w-1/2 mx-auto">
          
        </div>
        
        <hr class="border-gray-200 mb-20 w-1/2 mx-auto">
        
        <!-- Quote Section -->
        <article id="about" class="relative mb-20 blur-load scroll-mt-24">
          <div class="bg-ink text-paper p-12 md:p-16 text-center rounded-sm shadow-retro max-w-3xl mx-auto relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-forest via-ochre to-forest"></div>
            <div class="absolute top-6 left-6 text-6xl text-gray-700 opacity-30 font-serif">"</div>
            <blockquote class="font-serif text-2xl md:text-3xl italic leading-loose z-10 relative">
              "Shader 代码不只是数学公式的堆砌，<br>它是光线在物体表面起舞的编排。"
            </blockquote>
            <cite class="block mt-8 font-body text-xs tracking-[0.2em] uppercase text-ochre">— TechArt Notes</cite>
          </div>
        </article>
        
      </main>
    </div>
  </div>
  
  <Footer />
</BaseLayout>
