---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('articles')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="TechArt Chronicle">
    <Header />
	<main class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
             <!-- Sidebar -->
            <aside class="hidden lg:block lg:col-span-3 relative">
                <div class="sticky top-8 space-y-12">
                    <nav class="space-y-4">
                        <h4 class="font-serif text-lg pb-2 mb-2 italic text-gray-400">Sections</h4>
                        <a href="#" class="block text-ochre font-bold transition-colors">Articles</a>
                        <a href="#" class="block text-ink hover:text-ochre transition-colors">Videos</a>
                        <a href="#" class="block text-ink hover:text-ochre transition-colors">Tools</a>
                    </nav>
                </div>
            </aside>

            <!-- Main Stream -->
            <div class="lg:col-span-8 lg:col-start-5 relative grid gap-8">
                <div class="mb-12">
                    <span class="text-ochre font-bold text-xs tracking-wider uppercase mb-2 block">All Posts</span>
                    <p class="text-gray-600 italic font-serif">Exploring the intersection of technology and art.</p>
                </div>

                {posts.map((post) => (
                    <a href={`/articles/${post.slug}/`} class="retro-card p-8 md:grid md:grid-cols-3 gap-6 items-center text-ink group block">
                         <div class="md:col-span-1 aspect-[4/3] bg-gray-200 overflow-hidden rounded-sm">
                            <img src={post.data.heroImage || "https://placehold.co/600x400"} 
                                 class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500 grayscale-[0.2]"
                                 alt={post.data.title} />
                        </div>
                        <div class="md:col-span-2 mt-4 md:mt-0">
                            <div class="text-xs text-ochre font-bold uppercase tracking-wider mb-2">{post.data.category || 'Article'}</div>
                             <h2 class="font-serif text-2xl font-bold mb-2 group-hover:text-ochre transition-colors">
                                {post.data.title}
                            </h2>
                            <p class="text-sm text-gray-600 line-clamp-2 mb-4">
                                {post.data.description}
                            </p>
                            <span class="text-xs text-gray-400 italic font-serif">
                                {post.data.pubDate.toLocaleDateString('zh-CN')}
                            </span>
                        </div>
                    </a>
                ))}
            </div>
        </div>
	</main>
</Layout>
