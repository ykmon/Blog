---
// tools/index.astro - 工具列表页
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SubPageSidebar from '../../components/SubPageSidebar.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = 'Houdini Tools - TechArt Chronicle';
const description = 'Houdini 工具库 - Python 脚本和 HDA 开发技巧收录，提升程序化工作流效率。';

import { tools } from '../../data/content';
---

<BaseLayout title={pageTitle} description={description}>
  <Header title="Library" subPage />

  <div class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

      <SubPageSidebar currentSection="tools" />

      <!-- MAIN CONTENT -->
      <main class="lg:col-span-8 lg:col-start-5 relative">
        <article class="prose prose-lg prose-slate max-w-none mb-12">
          <span class="text-ochre font-bold text-xs tracking-wider uppercase mb-2 block">Houdini / Python</span>
          <h1 class="font-serif text-4xl mb-4 leading-tight">Procedural Toolset</h1>
          <p class="text-gray-600 italic">Houdini 项目中使用的部分 Python 脚本和 HDA 开发技巧收录。</p>
        </article>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {tools.map((tool) => (
            <a href={tool.href} class="retro-card p-6 block group">
              <div class="text-ochre text-2xl mb-2 group-hover:scale-110 transition-transform origin-left">{tool.icon}</div>
              <h3 class="font-bold text-lg mb-2 font-serif text-ink">{tool.title}</h3>
              <p class="text-sm text-gray-500">{tool.description}</p>
            </a>
          ))}
        </div>

        <div class="mt-20 border-t border-gray-300 pt-8 flex justify-between items-center text-sm font-serif italic text-gray-500">
          <span>Index</span>
          <a href="#top" class="text-ochre hover:underline">Back to Top ↑</a>
        </div>
      </main>
    </div>
  </div>

  <Footer />
</BaseLayout>
