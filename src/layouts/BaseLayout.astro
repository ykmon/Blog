---
// BaseLayout.astro - 基础布局模板
import '../styles/fonts.css';
import '../styles/global.css';
import MobileNav from '../components/MobileNav.astro';
export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  keywords?: string;
}

const { 
  title, 
  description = '技术美术博客 - 分享 Unreal Engine、Houdini、Shader 开发、自动化管线等技术笔记与经验。',
  canonical = new URL(Astro.url.pathname, Astro.site).href,
  image = '/Resource/ykmon.jpg',
  keywords = '技术美术, Technical Artist, Unreal Engine, Houdini, Shader, Python, 游戏开发'
} = Astro.props;

const absoluteImageUrl = new URL(image, Astro.site).href;
---

<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, shrink-to-fit=no, viewport-fit=cover">
  <title>{title}</title>
  
  <!-- SEO Meta Tags -->
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <meta name="author" content="YKMON">
  <link rel="canonical" href={canonical}>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  
  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:site_name" content="TechArt Chronicle">
  <meta property="og:image" content={absoluteImageUrl}>
  <meta property="og:locale" content="zh_CN">
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={absoluteImageUrl}>
  
  <!-- Fonts — 自托管字体，通过 fonts.css 中的 @font-face + unicode-range 按需加载 -->
  
  <!-- KaTeX - 异步按需加载，仅在有数学公式时才加载 -->
  <!-- 代码高亮已由 Astro 内置 Shiki 在构建时完成，无需运行时 JS -->
</head>

<body id="top" class="antialiased min-h-screen font-body">
  <!-- Skip to content — 无障碍快捷跳转 -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-forest focus:text-white focus:rounded-sm focus:text-sm">
    跳转到主要内容
  </a>
  <div id="main-content">
    <slot />
  </div>
  <MobileNav />
  
  <!-- 统一过滤控制器（搜索 + 标签） -->
  <script>
    import '../scripts/init-filter';
  </script>

  <script>
    // KaTeX — 异步按需加载数学公式渲染
    async function loadKaTeX() {
      // 检测页面中是否包含 LaTeX 数学公式分隔符 \(...\) 或 \[...\] 或 $$...$$
      const body = document.body.innerHTML;
      const hasMath = /\\\([\s\S]*?\\\)|\\\[[\s\S]*?\\\]|\$\$[\s\S]*?\$\$/.test(body);
      if (!hasMath) return; // 无数学公式则跳过

      // 加载 KaTeX CSS
      if (!document.querySelector('link[href*="katex"]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.css';
        link.crossOrigin = 'anonymous';
        document.head.appendChild(link);
      }

      // 动态加载 KaTeX JS
      const loadScript = (src: string): Promise<void> => new Promise((resolve, reject) => {
        if (document.querySelector(`script[src="${src}"]`)) { resolve(); return; }
        const s = document.createElement('script');
        s.src = src;
        s.crossOrigin = 'anonymous';
        s.onload = () => resolve();
        s.onerror = () => reject(new Error(`Failed to load ${src}`));
        document.head.appendChild(s);
      });

      try {
        // 加载 KaTeX 核心
        await loadScript('https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.js');
        // 加载 auto-render 扩展（自动扫描并渲染页面中的数学公式）
        await loadScript('https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/contrib/auto-render.min.js');

        const renderMathInElement = (window as any).renderMathInElement;
        if (renderMathInElement) {
          renderMathInElement(document.body, {
            delimiters: [
              { left: '$$', right: '$$', display: true },
              { left: '\\[', right: '\\]', display: true },
              { left: '\\(', right: '\\)', display: false },
            ],
            throwOnError: false,
            // 忽略这些标签内的内容，避免误渲染
            ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
          });
        }
      } catch (e) {
        console.warn('KaTeX load failed:', e);
      }
    }

    // Lazy Load Effect with Intersection Observer（幂等：先断开旧 observer）
    let blurObserver: IntersectionObserver | null = null;
    let eagerBlurObserver: IntersectionObserver | null = null;

    function initObserver() {
      // 断开旧的 observer，避免堆积
      if (blurObserver) {
        blurObserver.disconnect();
        blurObserver = null;
      }
      if (eagerBlurObserver) {
        eagerBlurObserver.disconnect();
        eagerBlurObserver = null;
      }

      const markLoaded: IntersectionObserverCallback = (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add('loaded');
          observer.unobserve(entry.target);
        });
      };

      blurObserver = new IntersectionObserver(markLoaded, {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px',
      });

      eagerBlurObserver = new IntersectionObserver(markLoaded, {
        threshold: 0.01,
        rootMargin: '0px 0px 360px 0px',
      });

      document.querySelectorAll('.blur-load:not(.loaded)').forEach((el) => {
        if (el.getAttribute('data-blur-priority') === 'eager') {
          eagerBlurObserver!.observe(el);
          return;
        }

        blurObserver!.observe(el);
      });
    }

    function initPage() {
      loadKaTeX();
      initObserver();
    }
    
    // Support both static sites and View Transitions
    // 使用单次注册保护，避免 astro:page-load 重复绑定
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPage);
    } else {
      initPage();
    }

    if (!(window as any).__pageInitBound) {
      document.addEventListener('astro:page-load', initPage);
      (window as any).__pageInitBound = true;
    }
  </script>
</body>
</html>
