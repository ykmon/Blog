---
// articles/index.astro - 文章列表页
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articles } from '../../data/content';
import { parseISODate } from '../../utils/date';

const pageTitle = 'Articles - TechArt Chronicle';
const description = '技术美术文章合集 - Unreal Engine、Unity Shader、Houdini、GAMES 系列课程笔记等。';

// 按日期排序（最新优先，使用安全的 ISO 日期解析）
const sortedArticles = [...articles].sort((a, b) => 
  parseISODate(b.date) - parseISODate(a.date)
);
---

<BaseLayout title={pageTitle} description={description}>
  <Header title="Archive" subPage />

  <div class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

      <!-- SIDEBAR with TagFilter -->
      <Sidebar currentSection="articles" />

      <!-- MAIN CONTENT -->
      <main class="lg:col-span-9 relative">
        <div class="mb-12">
          <span class="text-ochre font-bold text-xs tracking-wider uppercase mb-2 block">All Posts</span>
          <p class="text-gray-600 italic font-serif">Exploring the intersection of technology and art.</p>
        </div>

        <div id="articles-container" class="grid gap-8">
          {sortedArticles.map((article) => (
            <ArticleCard {...article} />
          ))}
        </div>

        <div class="mt-20 border-t border-gray-300 pt-8 flex justify-between items-center text-sm font-serif italic text-gray-500">
          <span>Page 1 of 1</span>
          <a href="#" class="text-ochre hover:underline">Back to Top ↑</a>
        </div>
      </main>
    </div>
  </div>

  <Footer />
</BaseLayout>
