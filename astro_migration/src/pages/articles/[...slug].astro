---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('articles');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}
type Props = CollectionEntry<'articles'>;

const post = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title}>
	<main class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
            <!-- Sidebar placeholder for demo -->
             <aside class="hidden lg:block lg:col-span-3 relative">
                <div class="sticky top-8 space-y-12">
                    <a href="/" class="block text-ink hover:text-ochre transition-colors group">
                        <span class="text-xs font-bold text-gray-400 mr-2 group-hover:text-ochre">←</span> Back to Home
                    </a>
                </div>
            </aside>

            <article class="lg:col-span-8 lg:col-start-5 prose prose-achre max-w-none">
                <span class="text-ochre font-bold text-xs tracking-wider uppercase mb-2 block">{post.data.category}</span>
                <h1 class="font-serif text-4xl md:text-5xl mb-8 leading-tight">{post.data.title}</h1>
                <div class="text-sm text-gray-500 mb-8 font-serif italic">
                    {post.data.pubDate.toLocaleDateString('zh-CN')} • {post.data.readTime}
                </div>
                
                <Content />
            </article>
        </div>
	</main>
</Layout>
