---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/TopNav.astro';
import Footer from '../../components/Footer.astro';
import { formatDateCN, parseISODate } from '../../utils/date';
import { videos } from '../../data/content';

const sortedVideos = [...videos].sort((a, b) => parseISODate(b.date) - parseISODate(a.date));
---

<BaseLayout title="视频 - TechArt Chronicle" description="Houdini、Unreal Engine 和程序化工作流的视频演示。">
  <TopNav currentSection="videos" />
  <main class="reading-width page-main">
    <header class="page-heading"><h1>视频</h1><p>用影像记录节点流程、效果验证和制作中的细节。</p></header>
    <div class="space-y-14">
      {sortedVideos.map((video) => (
        <article>
          <div class="reading-list-title mb-4">
            <h2 class="text-xl">{video.title}</h2>
            <time class="text-sm text-gray-400" datetime={video.date}>{formatDateCN(video.date, true)}</time>
          </div>
          <div class="aspect-video bg-gray-100 overflow-hidden rounded-sm">
            <iframe src={`https://player.bilibili.com/player.html?isOutside=true&aid=${video.aid}&bvid=${video.bvid}&cid=${video.cid}&p=1&autoplay=0`} title={video.title} loading="lazy" class="h-full w-full border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen />
          </div>
          <p class="mt-3 text-sm text-gray-500">{video.category} · {video.tags.join(' / ')}</p>
        </article>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
