---
// gallery/index.astro - 个人相册页
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/TopNav.astro';
import Footer from '../../components/Footer.astro';
import { formatDateCN } from '../../utils/date';
import { mapGalleryEntry, sortByDateDesc } from '../../utils/content';

const pageTitle = '相册 - TechArt Chronicle';
const description = 'YKMON 的个人相册，记录风景、扫街与日常观察。';

const galleryPhotos = sortByDateDesc(
  (await getCollection('gallery')).filter((entry) => entry.data.listed !== false).map(mapGalleryEntry)
);
const filterOptions = Array.from(
  new Set(['风景', '扫街', ...galleryPhotos.flatMap((photo) => [photo.category, ...photo.tags])].filter(Boolean))
);
const categoryCount = new Set(galleryPhotos.map((photo) => photo.category)).size;
---

<BaseLayout title={pageTitle} description={description}>
  <TopNav currentSection="gallery" subPage />

  <div class="reading-width page-main">
    <main class="space-y-12">
      <header class="page-heading">
        <h1>相册</h1>
        <p>风景、街角和偶然遇见的光。记录 {galleryPhotos.length} 张照片，{categoryCount} 种日常风景。</p>
      </header>
      {galleryPhotos.length > 0 ? (
        <>
          <section class="space-y-5" data-gallery-root>
            <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
              <div>
                <h2 class="text-2xl text-ink">按主题浏览</h2>
              </div>
              <div class="text-sm text-gray-500">
                <span data-gallery-count>{galleryPhotos.length}</span> / {galleryPhotos.length} 张
              </div>
            </div>

            <div class="flex flex-wrap gap-2">
              <button
                type="button"
                class="gallery-filter-btn tag-filter-btn active"
                data-gallery-filter="all"
                aria-pressed="true"
              >
                全部
              </button>
              {filterOptions.map((filter) => (
                <button
                  type="button"
                  class="gallery-filter-btn tag-filter-btn"
                  data-gallery-filter={filter}
                  aria-pressed="false"
                >
                  {filter}
                </button>
              ))}
            </div>

            <div class="gallery-masonry" data-gallery-grid>
              {galleryPhotos.map((photo, index) => {
                const filters = [photo.category, ...photo.tags].join(',');

                return (
                  <article
                    class="gallery-card group mb-8 break-inside-avoid overflow-hidden"
                    data-gallery-card
                    data-gallery-filters={filters}
                  >
                    <button
                      type="button"
                      class="block w-full text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ochre/70"
                      data-gallery-open
                      data-title={photo.title}
                      data-location={photo.location}
                      data-date={formatDateCN(photo.date, true)}
                      data-category={photo.category}
                      data-description={photo.description ?? ''}
                      data-image={photo.image}
                      data-alt={photo.imageAlt}
                      data-camera={photo.exif?.camera ?? ''}
                      data-lens={photo.exif?.lens ?? ''}
                      data-focal-length={photo.exif?.focalLength ?? ''}
                      data-aperture={photo.exif?.aperture ?? ''}
                      data-shutter-speed={photo.exif?.shutterSpeed ?? ''}
                      data-iso={photo.exif?.iso ?? ''}
                      data-taken-at={photo.exif?.takenAt ?? ''}
                    >
                      <div class="overflow-hidden bg-forest">
                        <img
                          loading={index < 4 ? 'eager' : 'lazy'}
                          decoding="async"
                          src={photo.image}
                          alt={photo.imageAlt}
                          class="h-auto w-full transition-transform duration-700 group-hover:scale-[1.03]"
                        />
                      </div>
                      <div class="py-4">
                        <div class="flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-normal">
                          <span class="text-gray-500">{photo.category}</span>
                          <span class="text-gray-400">{formatDateCN(photo.date, true)}</span>
                        </div>
                        <h3 class="mt-3 font-serif text-xl leading-tight text-ink transition-colors group-hover:text-forest">
                          {photo.title}
                        </h3>
                        <p class="mt-2 text-sm leading-6 text-gray-600">{photo.location}</p>
                        {photo.description && (
                          <p class="mt-2 line-clamp-2 text-sm leading-6 text-gray-500">{photo.description}</p>
                        )}
                      </div>
                    </button>
                  </article>
                );
              })}
            </div>
          </section>

          <div
            id="gallery-lightbox"
            class="fixed inset-0 z-[80] hidden overflow-y-auto bg-ink/90 p-4 backdrop-blur-sm md:p-8"
            aria-hidden="true"
          >
            <button
              type="button"
              class="absolute inset-0 h-full w-full cursor-default"
              data-gallery-close
              aria-label="关闭相册预览"
            ></button>

            <div class="relative mx-auto flex min-h-full max-w-6xl flex-col justify-center">
              <button
                type="button"
                class="absolute right-0 top-0 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full border border-paper/20 bg-paper/10 text-paper transition-all hover:bg-paper/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper/70"
                data-gallery-close
                aria-label="关闭相册预览"
              >
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>

              <figure class="relative grid gap-5 pt-14 lg:grid-cols-[minmax(0,1fr),360px] lg:items-center lg:pt-0">
                <div class="flex min-h-0 items-center justify-center">
                  <img
                    id="gallery-lightbox-image"
                    src=""
                    alt=""
                    class="max-h-[70vh] w-auto max-w-full rounded-sm object-contain  lg:max-h-[82vh]"
                  />
                </div>
                <figcaption class="rounded-sm border border-paper/10 bg-paper/10 p-5 text-paper backdrop-blur">
                  <div id="gallery-lightbox-meta" class="text-[10px] font-bold uppercase tracking-normal text-paper/55"></div>
                  <h2 id="gallery-lightbox-title" class="mt-3 font-serif text-3xl leading-tight"></h2>
                  <p id="gallery-lightbox-location" class="mt-3 text-sm leading-6 text-paper/75"></p>
                  <p id="gallery-lightbox-description" class="mt-4 text-sm leading-7 text-paper/65"></p>
                  <div id="gallery-lightbox-exif" class="mt-5 hidden border-t border-paper/10 pt-5">
                    <div class="text-[10px] font-bold uppercase tracking-normal text-paper/55">拍摄参数</div>
                    <dl class="mt-3 grid grid-cols-2 gap-3">
                      <div class="gallery-exif-item col-span-2 hidden rounded-2xl border border-paper/10 bg-paper/5 p-3" data-exif-field="camera">
                        <dt class="text-[10px] font-bold uppercase tracking-normal text-paper/45">Camera</dt>
                        <dd class="mt-1 text-sm leading-6 text-paper" data-exif-value></dd>
                      </div>
                      <div class="gallery-exif-item col-span-2 hidden rounded-2xl border border-paper/10 bg-paper/5 p-3" data-exif-field="lens">
                        <dt class="text-[10px] font-bold uppercase tracking-normal text-paper/45">Lens</dt>
                        <dd class="mt-1 text-sm leading-6 text-paper" data-exif-value></dd>
                      </div>
                      <div class="gallery-exif-item hidden rounded-2xl border border-paper/10 bg-paper/5 p-3" data-exif-field="focalLength">
                        <dt class="text-[10px] font-bold uppercase tracking-normal text-paper/45">Focal</dt>
                        <dd class="mt-1 text-sm leading-6 text-paper" data-exif-value></dd>
                      </div>
                      <div class="gallery-exif-item hidden rounded-2xl border border-paper/10 bg-paper/5 p-3" data-exif-field="aperture">
                        <dt class="text-[10px] font-bold uppercase tracking-normal text-paper/45">Aperture</dt>
                        <dd class="mt-1 text-sm leading-6 text-paper" data-exif-value></dd>
                      </div>
                      <div class="gallery-exif-item hidden rounded-2xl border border-paper/10 bg-paper/5 p-3" data-exif-field="shutterSpeed">
                        <dt class="text-[10px] font-bold uppercase tracking-normal text-paper/45">Shutter</dt>
                        <dd class="mt-1 text-sm leading-6 text-paper" data-exif-value></dd>
                      </div>
                      <div class="gallery-exif-item hidden rounded-2xl border border-paper/10 bg-paper/5 p-3" data-exif-field="iso">
                        <dt class="text-[10px] font-bold uppercase tracking-normal text-paper/45">ISO</dt>
                        <dd class="mt-1 text-sm leading-6 text-paper" data-exif-value></dd>
                      </div>
                      <div class="gallery-exif-item col-span-2 hidden rounded-2xl border border-paper/10 bg-paper/5 p-3" data-exif-field="takenAt">
                        <dt class="text-[10px] font-bold uppercase tracking-normal text-paper/45">Taken</dt>
                        <dd class="mt-1 text-sm leading-6 text-paper" data-exif-value></dd>
                      </div>
                    </dl>
                  </div>
                </figcaption>
              </figure>
            </div>
          </div>
        </>
      ) : (
        <section class="rounded-sm border border-dashed border-ink/15 bg-white/70 p-8 text-center md:p-12">
          <p class="text-[11px] font-bold uppercase tracking-normal text-ochre">Coming Soon</p>
          <h2 class="mt-3 font-serif text-3xl text-ink">相册整理中</h2>
          <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-gray-600">
            新的照片正在整理中，稍后再来看看。
          </p>
        </section>
      )}

      <div class="mt-20 flex items-center justify-between border-t border-gray-300 pt-8 text-sm text-gray-500">
        <span>共 {galleryPhotos.length} 张照片</span>
        <a href="#top" class="text-ochre hover:underline">返回顶部 ↑</a>
      </div>
    </main>
  </div>

  <Footer />
</BaseLayout>

<style>
  .gallery-masonry {
    column-count: 1;
    column-gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .gallery-masonry {
      column-count: 2;
    }
  }

  @media (min-width: 1024px) {
    .gallery-masonry {
      column-count: 3;
    }
  }

  .gallery-filter-btn.active {
    background-color: #333333;
    border-color: #333333;
    color: white;
  }

  .gallery-card.is-hidden {
    display: none;
  }

</style>

<script>
  let galleryAbort: AbortController | null = null;

  function initGalleryPage() {
    if (galleryAbort) {
      galleryAbort.abort();
    }

    galleryAbort = new AbortController();
    const { signal } = galleryAbort;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-gallery-card]'));
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]'));
    const count = document.querySelector<HTMLElement>('[data-gallery-count]');
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImage = document.getElementById('gallery-lightbox-image') as HTMLImageElement | null;
    const lightboxMeta = document.getElementById('gallery-lightbox-meta');
    const lightboxTitle = document.getElementById('gallery-lightbox-title');
    const lightboxLocation = document.getElementById('gallery-lightbox-location');
    const lightboxDescription = document.getElementById('gallery-lightbox-description');
    const lightboxExif = document.getElementById('gallery-lightbox-exif');
    const exifItems = Array.from(document.querySelectorAll<HTMLElement>('[data-exif-field]'));

    const setActiveFilter = (activeFilter: string) => {
      let visibleCount = 0;

      cards.forEach((card) => {
        const filters = (card.dataset.galleryFilters ?? '').split(',').filter(Boolean);
        const isVisible = activeFilter === 'all' || filters.includes(activeFilter);
        card.classList.toggle('is-hidden', !isVisible);
        if (isVisible) visibleCount += 1;
      });

      filterButtons.forEach((button) => {
        const active = button.dataset.galleryFilter === activeFilter;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      if (count) {
        count.textContent = String(visibleCount);
      }
    };

    filterButtons.forEach((button) => {
      button.addEventListener(
        'click',
        () => {
          setActiveFilter(button.dataset.galleryFilter ?? 'all');
        },
        { signal }
      );
    });

    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.classList.add('hidden');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('gallery-lightbox-open');
      if (lightboxImage) {
        lightboxImage.src = '';
        lightboxImage.alt = '';
      }
      if (lightboxExif) {
        lightboxExif.classList.add('hidden');
      }
      exifItems.forEach((item) => {
        item.classList.add('hidden');
        const valueElement = item.querySelector<HTMLElement>('[data-exif-value]');
        if (valueElement) {
          valueElement.textContent = '';
        }
      });
    };

    const updateExifDetails = (button: HTMLElement) => {
      const exifValues: Record<string, string> = {
        camera: button.dataset.camera ?? '',
        lens: button.dataset.lens ?? '',
        focalLength: button.dataset.focalLength ?? '',
        aperture: button.dataset.aperture ?? '',
        shutterSpeed: button.dataset.shutterSpeed ?? '',
        iso: button.dataset.iso ?? '',
        takenAt: button.dataset.takenAt ?? '',
      };
      let hasExif = false;

      exifItems.forEach((item) => {
        const field = item.dataset.exifField ?? '';
        const value = exifValues[field] ?? '';
        const valueElement = item.querySelector<HTMLElement>('[data-exif-value]');

        if (valueElement) {
          valueElement.textContent = value;
        }

        item.classList.toggle('hidden', !value);
        if (value) {
          hasExif = true;
        }
      });

      if (lightboxExif) {
        lightboxExif.classList.toggle('hidden', !hasExif);
      }
    };

    document.querySelectorAll<HTMLElement>('[data-gallery-open]').forEach((button) => {
      button.addEventListener(
        'click',
        () => {
          if (!lightbox || !lightboxImage || !lightboxMeta || !lightboxTitle || !lightboxLocation || !lightboxDescription) return;

          lightboxImage.src = button.dataset.image ?? '';
          lightboxImage.alt = button.dataset.alt ?? '';
          lightboxMeta.textContent = `${button.dataset.category ?? ''} / ${button.dataset.date ?? ''}`;
          lightboxTitle.textContent = button.dataset.title ?? '';
          lightboxLocation.textContent = button.dataset.location ?? '';
          lightboxDescription.textContent = button.dataset.description ?? '';
          updateExifDetails(button);
          lightbox.classList.remove('hidden');
          lightbox.setAttribute('aria-hidden', 'false');
          document.body.classList.add('gallery-lightbox-open');
        },
        { signal }
      );
    });

    document.querySelectorAll('[data-gallery-close]').forEach((button) => {
      button.addEventListener('click', closeLightbox, { signal });
    });

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape') {
          closeLightbox();
        }
      },
      { signal }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGalleryPage);
  } else {
    initGalleryPage();
  }

  const galleryWindow = window as Window & { __galleryPageBound?: boolean };
  if (!galleryWindow.__galleryPageBound) {
    document.addEventListener('astro:page-load', initGalleryPage);
    galleryWindow.__galleryPageBound = true;
  }
</script>
