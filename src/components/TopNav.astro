---
import SearchBox from './SearchBox.astro';
import { navItems, type SectionId } from '../data/navigation';

export interface Props {
  currentSection?: SectionId;
  showSearch?: boolean;
  showProfile?: boolean;
  subPage?: boolean;
  contextLabel?: string;
  contextDescription?: string;
}

const { currentSection = 'home', showSearch = true } = Astro.props;
---

<header class="site-header">
  <div class="site-header-inner">
    <button id="mobile-nav-toggle" class="menu-toggle" type="button" aria-label="打开导航菜单" aria-expanded="false" aria-controls="mobile-nav-drawer" title="菜单">
      <svg id="mobile-nav-menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      <svg id="mobile-nav-close-icon" class="hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
    </button>
    <a class="site-brand" href="/" aria-label="YKMON 首页">
      <img src="/Resource/ykmon.jpg" alt="" width="36" height="36" />
      <span>YKMON</span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      {navItems.filter((item) => item.id !== 'home').map((item) => (
        <a href={item.href} aria-current={currentSection === item.id ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="site-search">{showSearch && <SearchBox />}</div>
  </div>
</header>
