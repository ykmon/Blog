---
import SearchBox from './SearchBox.astro';
import { getNavItemById, navItems, type SectionId } from '../data/navigation';

export interface Props {
  currentSection?: SectionId;
  showSearch?: boolean;
  showProfile?: boolean;
  subPage?: boolean;
  contextLabel?: string;
  contextDescription?: string;
}

const {
  currentSection = 'home',
  showSearch = true,
  showProfile = true,
  subPage = false,
  contextLabel,
  contextDescription,
} = Astro.props;

const currentItem = getNavItemById(currentSection);
const finalContextLabel = contextLabel ?? currentItem.labelEn.toUpperCase();
const finalContextDescription = contextDescription ?? currentItem.description;
const profileDescription = '致力自动化管线开发，非传统技术美术，从项目管理到技术落地。';
---

<header class="top-nav-sticky z-40">
  <div class="container mx-auto max-w-7xl px-4 pt-5 md:px-6 md:pt-6">
    <div class="rounded-[1.75rem] border border-ink/10 bg-white/70 p-3 shadow-[0_14px_34px_rgba(26,26,26,0.05)] backdrop-blur-sm md:p-4">
      <div class="flex items-center gap-3 md:gap-4">
        {showProfile ? (
          <a
            href="/"
            class="hidden min-w-[296px] rounded-2xl border border-ink/10 bg-white/80 px-3 py-2 transition-all duration-300 hover:border-ochre/30 lg:flex lg:items-center lg:gap-3"
            aria-label="返回首页"
          >
            <span class="h-10 w-10 overflow-hidden rounded-full border border-ink/10">
              <img
                loading="lazy"
                decoding="async"
                src="/Resource/ykmon.jpg"
                alt="YKMON"
                width="40"
                height="40"
                class="h-full w-full object-cover"
              />
            </span>
            <span class="min-w-0">
              <span class="block truncate font-serif text-xl font-bold text-ink leading-none">YKMON</span>
              <span class="mt-1 block text-[10px] uppercase tracking-[0.3em] text-ochre">Technical Artist</span>
              <span class="mt-1 hidden text-[11px] leading-5 text-gray-500 xl:block">{profileDescription}</span>
            </span>
          </a>
        ) : (
          <a
            href="/"
            class="hidden min-w-[172px] rounded-2xl border border-ink/10 bg-white/80 px-3 py-2 font-serif text-lg text-ink transition-all duration-300 hover:border-ochre/30 lg:block"
            aria-label="返回首页"
          >
            TechArt Chronicle
          </a>
        )}

        <a href="/" class="flex min-w-0 items-center gap-2 rounded-2xl border border-ink/10 bg-white/80 px-3 py-2 lg:hidden">
          <span class="h-8 w-8 overflow-hidden rounded-full border border-ink/10">
            <img
              loading="lazy"
              decoding="async"
              src="/Resource/ykmon.jpg"
              alt="YKMON"
              width="32"
              height="32"
              class="h-full w-full object-cover"
            />
          </span>
          <span class="truncate font-serif text-base text-ink">YKMON</span>
        </a>

        <nav
          class="hidden min-w-0 flex-1 grid-cols-6 gap-2 rounded-2xl border border-ink/10 bg-white/80 p-2 lg:grid"
          aria-label="主导航"
        >
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'group rounded-xl border px-3 py-2 text-center transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ochre/70',
                currentSection === item.id
                  ? 'border-forest/25 bg-forest/10 text-forest shadow-[0_6px_16px_rgba(45,74,62,0.12)]'
                  : 'border-transparent text-ink hover:border-ochre/15 hover:text-ochre',
              ]}
              aria-current={currentSection === item.id ? 'page' : undefined}
            >
              <span class:list={['block text-[10px] font-bold tracking-[0.3em]', currentSection === item.id ? 'text-forest' : 'text-gray-400 group-hover:text-ochre']}>
                {item.num}
              </span>
              <span class="mt-1 block text-sm font-medium">{item.label}</span>
              <span class="mt-1 block text-[10px] uppercase tracking-[0.25em] text-gray-400 group-hover:text-ochre">{item.labelEn}</span>
            </a>
          ))}
        </nav>

        <button
          id="mobile-nav-toggle"
          class="ml-auto inline-flex h-11 w-11 items-center justify-center rounded-full border border-ink/10 bg-white text-ink transition-all duration-300 hover:border-ochre hover:text-ochre focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ochre/70 lg:hidden"
          aria-label="打开导航菜单"
          aria-expanded="false"
          aria-controls="mobile-nav-drawer"
        >
          <svg id="mobile-nav-menu-icon" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg id="mobile-nav-close-icon" class="hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="mt-3 border-t border-ink/10 pt-3">
        <div class:list={['gap-3 lg:items-start', showSearch ? 'grid lg:grid-cols-[minmax(0,1fr),auto]' : 'flex justify-end']}>
          {showSearch && (
            <div class="top-nav-search">
              <SearchBox />
            </div>
          )}

          <div class:list={['rounded-2xl border border-ink/10 bg-white/80 px-4 py-3', showSearch ? 'lg:min-w-[280px]' : 'w-full sm:w-auto']}>
            <p class="text-[10px] font-bold uppercase tracking-[0.35em] text-gray-400">{finalContextLabel}</p>
            <p class:list={['mt-2 text-sm leading-6 text-gray-600', subPage ? 'max-w-[42ch]' : 'max-w-[36ch]']}>
              {finalContextDescription}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .top-nav-search :global(.search-box) {
    margin-bottom: 0;
  }

  .top-nav-search :global([data-role='search-input']) {
    border-radius: 9999px;
    border-color: rgba(26, 26, 26, 0.12);
    background: rgba(255, 255, 255, 0.88);
    padding-top: 0.68rem;
    padding-bottom: 0.68rem;
  }

  .top-nav-search :global([data-role='search-input']:focus) {
    border-color: #8a6240;
  }

  .top-nav-search :global([data-role='search-clear']) {
    right: 1rem;
  }
</style>
