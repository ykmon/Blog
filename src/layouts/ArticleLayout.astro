---
import BaseLayout from './BaseLayout.astro';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import ArticleToc from '../components/ArticleToc.astro';
import { formatDateCN } from '../utils/date';

export interface Props {
  title: string;
  category: string;
  categoryLink?: string;
  date?: string;
  description?: string;
  image?: string;
  keywords?: string;
  tags?: string[];
  slug?: string;
  showToc?: boolean;
}
const { title, category, categoryLink = '/articles/', date, description, image, keywords, tags = [], slug = '', showToc = true } = Astro.props;
const breadcrumbItems = [{ label: '文章', href: '/articles/' }, { label: category, href: categoryLink }, { label: title }];
---

<BaseLayout title={`${title} - TechArt Chronicle`} description={description} image={image} keywords={keywords}>
  <TopNav currentSection="articles" />
  <main class="reading-width page-main article-main">
    <Breadcrumb items={breadcrumbItems} />
    <header class="page-heading article-heading">
      <h1>{title}</h1>
      <div class="article-meta">
        {date && <><time datetime={date}>{formatDateCN(date, true)}</time><span aria-hidden="true">·</span></>}
        <a href={categoryLink}>{category}</a>
      </div>
      {description && <p>{description}</p>}
    </header>
    {showToc && <div class="article-toc-position"><ArticleToc /></div>}
    <article class="article-prose prose prose-lg prose-slate max-w-none" data-article-content data-content-body>
      <slot />
    </article>
    {slug && tags.length > 0 && <RelatedArticles currentSlug={slug} tags={tags} category={category} limit={3} />}
    <div class="mt-16 flex justify-between border-t border-gray-100 pt-6 text-sm text-gray-500">
      <a href={categoryLink} class="hover:underline">{categoryLink === '/series/' ? '← 返回系列笔记' : '← 返回文章列表'}</a>
      <a href="#top" class="hover:underline">返回顶部 ↑</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
