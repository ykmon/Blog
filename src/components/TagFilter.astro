---
// TagFilter.astro - 标签过滤器组件（委托 FilterController 统一过滤）
// 支持多实例：桌面 Sidebar + 移动端 MobileNav 各一个
import { tagCategories } from '../data/content';
---

<div class="tag-filter" data-role="tag-filter">
  <div class="flex items-center justify-between mb-4">
    <h4 class="font-serif text-lg border-b border-gray-300 pb-2 italic flex-1">Filter by Tags</h4>
  </div>
  
  <div data-role="filter-status" class="hidden mb-4 text-sm text-gray-600 italic">
    <span data-role="filter-count"></span>
    <button data-role="clear-filters" class="ml-2 text-ochre hover:underline">&times; Clear</button>
  </div>

  <div class="flex flex-wrap gap-1.5 max-h-[60vh] overflow-y-auto pr-2">
    {Object.values(tagCategories).flat().map(tag => (
      <button 
        class="tag-btn px-2 py-0.5 bg-gray-200 text-xs text-gray-600 rounded-full hover:bg-forest hover:text-white transition-colors cursor-pointer"
        data-tag={tag}
      >
        {tag}
      </button>
    ))}
  </div>
</div>

<style>
  .tag-btn.active {
    background-color: #2d4a3e; /* forest */
    color: white;
  }
</style>
