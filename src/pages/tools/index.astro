---
// tools/index.astro - 工具列表页（编辑部风格）
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import UnifiedSidebar from '../../components/UnifiedSidebar.astro';
import Footer from '../../components/Footer.astro';
import { tools } from '../../data/content';

const pageTitle = 'Houdini Tools - TechArt Chronicle';
const description = 'Houdini 工具库 - Python 脚本和 HDA 开发技巧收录，提升程序化工作流效率。';
---

<BaseLayout title={pageTitle} description={description}>
  <Header title="Library" subPage subtitle="A practical toolbox for Houdini workflows, Python scripts, and small HDA utilities." />

  <div class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <UnifiedSidebar currentSection="tools" showProfile={false} />

      <main class="lg:col-span-9 relative pl-0 lg:pl-12 space-y-12">
        <section class="blur-load rounded-[2rem] border border-ink/10 bg-white/80 p-6 md:p-8 shadow-[0_18px_48px_rgba(26,26,26,0.06)]">
          <div class="grid gap-8 lg:grid-cols-[1.2fr,0.8fr] lg:items-center">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">Tools / Houdini / Python</p>
              <h1 class="mt-3 font-serif text-4xl md:text-5xl xl:text-6xl leading-[0.95] text-ink">
                工具箱，不是清单
              </h1>
              <p class="mt-4 max-w-3xl text-sm md:text-base leading-7 text-gray-600">
                这里收集了我在 Houdini 项目里用到的小脚本、HDA 相关技巧以及一些能节省重复劳动的思路。
              </p>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
              <div class="rounded-[1.5rem] border border-ink/10 bg-paper p-5">
                <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400">Tools</div>
                <div class="mt-2 font-serif text-3xl text-ink">{tools.length}</div>
                <div class="mt-2 text-sm leading-6 text-gray-600">个工具条目</div>
              </div>
              <div class="rounded-[1.5rem] border border-ink/10 bg-paper p-5">
                <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400">Theme</div>
                <div class="mt-2 font-serif text-3xl text-ink">Houdini</div>
                <div class="mt-2 text-sm leading-6 text-gray-600">程序化工作流</div>
              </div>
            </div>
          </div>
        </section>

        <section class="space-y-5">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">Toolset</p>
            <h2 class="mt-2 font-serif text-3xl text-ink">可复用的小工具</h2>
          </div>

          <div class="grid gap-5 md:grid-cols-2">
            {tools.map((tool) => (
              <a
                href={tool.href}
                class="group rounded-[1.5rem] border border-ink/10 bg-white/80 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-ochre hover:shadow-[0_16px_36px_rgba(138,98,64,0.12)]"
              >
                <div class="flex items-start gap-4">
                  <div class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-2xl bg-forest/10 text-2xl text-forest transition-transform duration-300 group-hover:scale-110">
                    {tool.icon}
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.3em]">
                      <span class="rounded-full bg-ochre/10 px-2.5 py-1 text-ochre">Houdini</span>
                      <span class="rounded-full bg-gray-100 px-2.5 py-1 text-gray-600">Code</span>
                    </div>
                    <h3 class="mt-3 font-serif text-2xl leading-tight text-ink transition-colors group-hover:text-forest">
                      {tool.title}
                    </h3>
                    <p class="mt-3 text-sm leading-7 text-gray-600">
                      {tool.description}
                    </p>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section class="rounded-[2rem] border border-ink/10 bg-[linear-gradient(180deg,rgba(26,26,26,0.98),rgba(45,74,62,0.92))] p-6 md:p-8 text-paper shadow-[0_18px_48px_rgba(26,26,26,0.12)]">
          <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-paper/55">Why it exists</p>
          <h2 class="mt-3 font-serif text-3xl">减少重复操作，把时间留给内容本身</h2>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-paper/75">
            这些工具和脚本都偏向解决高频的小问题，不追求炫技，只追求在真实项目里能持续复用。
          </p>
        </section>

        <div class="mt-20 border-t border-gray-300 pt-8 flex justify-between items-center text-sm font-serif italic text-gray-500">
          <span>Index</span>
          <a href="#top" class="text-ochre hover:underline">Back to Top ↑</a>
        </div>
      </main>
    </div>
  </div>

  <Footer />
</BaseLayout>
