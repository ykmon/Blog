---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles, tools, videos, type ContentItem } from '../data/content';

const pageTitle = 'TechArt Chronicle | 技术美术志';
const description = '技术美术博客 - 分享 Unreal Engine、Houdini、Shader 开发、自动化管线等技术笔记与经验。';

// Merge and Sort
const allContent: ContentItem[] = [...articles, ...tools, ...videos].sort((a, b) => {
  return new Date(b.date).getTime() - new Date(a.date).getTime();
});

function getMonthDay(dateStr: string) {
  const d = new Date(dateStr);
  return `${d.getMonth() + 1}月${d.getDate()}日`;
}
---

<BaseLayout title={pageTitle} description={description}>
  <Header title="TechArt Chronicle." subtitle="不要温和地走入那良夜。<br>Do not go gentle into that good night." />

  <div class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

      <!-- SIDEBAR -->
      <Sidebar currentSection="home" />

      <!-- MAIN CONTENT -->
      <main class="lg:col-span-9 relative pl-0 lg:pl-12">
        <div class="timeline-line hidden lg:block absolute left-12 top-0 bottom-0 width-px bg-gray-200" style="left: 2rem; width: 1px; z-index: 0;"></div>

        <div id="timeline-container">
          {allContent.map((item, index) => (
            <>
              {item.type === 'article' && (
                <article class="relative mb-20 md:grid md:grid-cols-12 gap-8 items-start blur-load group scroll-mt-24" data-tags={item.tags?.join(',')}>
                  <div class="hidden lg:block absolute left-8 top-0 -translate-x-[calc(50%+1px)] bg-paper py-1 text-xs font-bold text-ochre border border-gray-300 z-10 w-fit px-2">
                    {getMonthDay(item.date)}
                  </div>
                  <div class="md:col-span-12 lg:col-span-12">
                    <div class="flex flex-col mb-4">
                      <span class="text-ochre font-bold text-xs tracking-wider uppercase mb-2">No. {String(allContent.length - index).padStart(3, '0')} — {item.category}</span>
                      <a href={item.href} class="block">
                        <h2 class="font-serif text-3xl md:text-5xl font-bold leading-tight text-ink group-hover:text-forest transition-colors cursor-pointer">
                          {item.title}
                        </h2>
                      </a>
                    </div>
                    <div class="grid md:grid-cols-2 gap-8 relative z-20">
                      <div class="font-body text-gray-700 leading-relaxed text-lg text-justify">
                        <a href={item.href} class="block hover:text-ink transition-colors">
                          <p class="drop-cap">{item.description}</p>
                        </a>
                      </div>
                      <div class="relative pt-2">
                        <a href={item.href} class="block aspect-[4/3] bg-gray-200 overflow-hidden rounded-sm shadow-md">
                          {item.image ? (
                            <img loading="lazy" decoding="async" src={item.image} class="object-cover w-full h-full hover:scale-105 transition-transform duration-700 grayscale-[0.2]" alt={item.title} />
                          ) : (
                            <div class="w-full h-full bg-forest flex items-center justify-center text-paper font-serif italic text-2xl">
                              {item.category}
                            </div>
                          )}
                        </a>
                        <div class="mt-4 flex justify-between items-center border-t border-gray-300 pt-3">
                          <span class="text-xs text-gray-500 uppercase tracking-widest">{item.date} • {item.readTime}</span>
                          <a href={item.href} class="text-sm text-ochre italic font-serif hover:underline">Read Full Article ⟶</a>
                        </div>
                      </div>
                    </div>
                  </div>
                </article>
              )}

              {item.type === 'video' && (
                <article class="relative mb-20 blur-load scroll-mt-24" data-tags={item.tags?.join(',')}>
                  <div class="hidden lg:block absolute left-8 top-0 -translate-x-[calc(50%+1px)] bg-paper py-1 text-xs font-bold text-ochre border border-gray-300 z-10 w-fit px-2">
                    {getMonthDay(item.date)}
                  </div>
                  <div class="max-w-4xl mx-auto">
                    <div class="bg-white p-3 retro-frame transform hover:-translate-y-1 transition-transform duration-500 shadow-[10px_10px_20px_rgba(0,0,0,0.05)] border-8 border-[#e5e5e0] outline outline-1 outline-[#d1d1cc] rounded-sm">
                      <div class="aspect-video bg-gray-800 relative overflow-hidden group">
                        <iframe
                          src={`https://player.bilibili.com/player.html?isOutside=true&aid=${item.aid}&bvid=${item.bvid}&cid=${item.cid}&p=1&autoplay=0`}
                          title={item.title}
                          scrolling="no" border="0" frameborder="0" framespacing="0"
                          allowfullscreen="true" class="w-full h-full absolute inset-0"></iframe>
                      </div>
                      <div class="p-6 flex justify-between items-end">
                        <div>
                          <h3 class="font-serif text-2xl font-bold italic mb-1">{item.title}</h3>
                          <p class="text-xs text-gray-500 uppercase tracking-widest">{item.category}</p>
                        </div>
                        <div class="text-ochre">◎ Bilibili</div>
                      </div>
                    </div>
                  </div>
                </article>
              )}

              {item.type === 'tool' && (
                <article class="relative mb-20 md:grid md:grid-cols-12 gap-8 items-center blur-load group scroll-mt-24" data-tags={item.tags?.join(',')}>
                  <div class="hidden lg:block absolute left-8 top-0 -translate-x-[calc(50%+1px)] bg-paper py-1 text-xs font-bold text-ochre border border-gray-300 z-10 w-fit px-2">
                    {getMonthDay(item.date)}
                  </div>
                  <div class="col-span-12 max-w-3xl mx-auto w-full">
                    <a href={item.href} class="block bg-white border border-gray-200 p-8 hover:border-ochre transition-all hover:shadow-lg group-hover:-translate-y-1">
                      <div class="flex items-start gap-6">
                        <div class="text-4xl text-ochre">{item.icon}</div>
                        <div>
                          <div class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">New Tool Released</div>
                          <h3 class="font-serif text-2xl font-bold text-ink mb-2 group-hover:text-ochre transition-colors">
                            {item.title}
                          </h3>
                          <p class="text-gray-600 italic font-serif">{item.description}</p>
                        </div>
                      </div>
                    </a>
                  </div>
                </article>
              )}

              {index < allContent.length - 1 && (
                <hr class="border-gray-200 mb-20 w-1/2 mx-auto" />
              )}
            </>
          ))}
        </div>

        <hr class="border-gray-200 mb-20 w-1/2 mx-auto">

        <!-- Entry: Quote -->
        <article id="about" class="relative mb-20 blur-load scroll-mt-24">
            <div class="bg-ink text-paper p-12 md:p-16 text-center rounded-sm shadow-retro max-w-3xl mx-auto relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-forest via-ochre to-forest"></div>
                <div class="absolute top-6 left-6 text-6xl text-gray-700 opacity-30 font-serif">“</div>
                <blockquote class="font-serif text-2xl md:text-3xl italic leading-loose z-10 relative">
                    "Shader 代码不只是数学公式的堆砌，<br>它是光线在物体表面起舞的编排。"
                </blockquote>
                <cite class="block mt-8 font-body text-xs tracking-[0.2em] uppercase text-ochre">— TechArt Notes</cite>
            </div>
        </article>

      </main>
    </div>
  </div>

  <Footer />
</BaseLayout>


