---
// articles/index.astro - 文章列表页
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articles } from '../../data/content';

const pageTitle = 'Articles - TechArt Chronicle';
const description = '技术美术文章合集 - Unreal Engine、Unity Shader、Houdini、GAMES 系列课程笔记等。';

// 按日期排序（最新优先）
const sortedArticles = [...articles].sort((a, b) => 
  new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<BaseLayout title={pageTitle} description={description} canonical="https://ykmon.github.io/Blog/articles/">
  <!-- Header -->
  <header class="py-12 md:py-16 text-center border-b border-gray-300 relative bg-paper z-10">
    <div class="container mx-auto px-6">
      <a href="/" class="inline-block">
        <div class="text-xs font-bold tracking-[0.3em] uppercase text-ochre mb-2 font-serif">TechArt Chronicle</div>
        <h1 class="font-serif text-3xl md:text-5xl font-bold tracking-tight text-ink">Archive</h1>
      </a>
    </div>
  </header>

  <div class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

      <!-- SIDEBAR with TagFilter -->
      <Sidebar currentSection="articles" />

      <!-- MAIN CONTENT -->
      <main class="lg:col-span-9 relative">
        <div class="mb-12">
          <span class="text-ochre font-bold text-xs tracking-wider uppercase mb-2 block">All Posts</span>
          <p class="text-gray-600 italic font-serif">Exploring the intersection of technology and art.</p>
        </div>

        <div id="articles-container" class="grid gap-8">
          {sortedArticles.map((article) => (
            <ArticleCard {...article} />
          ))}
        </div>

        <div class="mt-20 border-t border-gray-300 pt-8 flex justify-between items-center text-sm font-serif italic text-gray-500">
          <span>Page 1 of 1</span>
          <a href="#" class="text-ochre hover:underline">Back to Top ↑</a>
        </div>
      </main>
    </div>
  </div>

  <Footer />
</BaseLayout>
