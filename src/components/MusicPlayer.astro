---
interface Props {
  playlistId: string;
  server?: string; // 'netease', 'tencent', 'kugou', 'xiami', 'baidu'
  type?: string;   // 'playlist', 'song', 'album', 'artist', 'search'
  fixed?: boolean;
  mini?: boolean;
  autoplay?: boolean;
  theme?: string;
  volume?: number;
}

const { 
  playlistId, 
  server = 'netease', 
  type = 'playlist',
  fixed = false,
  mini = false,
  autoplay = true,
  theme = '#2d4a3e', // Forest Green
  volume = 0.2
} = Astro.props;
---

<!-- APlayer/MetingJS 样式和脚本将在用户交互时延迟加载 -->

<div class="music-player-container" id="music-player-container">
  <!-- Float Button (Side Tab Style) -->
  <button 
    class="music-toggle retro-card" 
    id="music-toggle" 
    aria-label="Toggle Music Player"
    title="Background Music"
  >
    <span class="icon">🎵</span>
    <span class="label">Music</span>
  </button>
  
  <!-- Player Panel (Wrapper for APlayer) -->
  <div class="music-panel retro-card" id="music-panel">
    <div class="music-header">
      <span class="title">Background Music</span>
      <button class="close-btn" id="music-close" aria-label="Close">×</button>
    </div>
    
    <!-- MetingJS 占位容器，脚本加载后自动初始化 -->
    <div id="meting-container"
      data-id={playlistId}
      data-server={server}
      data-type={type}
      data-fixed={fixed ? 'true' : 'false'}
      data-mini={mini ? 'true' : 'false'}
      data-autoplay={autoplay ? 'true' : 'false'}
      data-theme={theme}
      data-loop="all"
      data-order="list"
      data-preload="auto"
      data-list-folded="true"
      data-list-max-height="400px"
      data-lrc-type="0"
      data-volume={volume.toString()}
    ></div>
  </div>
</div>

<script>
  let playerLoaded = false;

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      if (document.querySelector(`script[src="${src}"]`)) { resolve(); return; }
      const s = document.createElement('script');
      s.src = src;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error(`Failed to load ${src}`));
      document.body.appendChild(s);
    });
  }

  async function loadMusicPlayer() {
    if (playerLoaded) return;
    playerLoaded = true;

    // 加载 APlayer CSS
    if (!document.querySelector('link[href*="APlayer"]')) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.css';
      document.head.appendChild(link);
    }

    // 按顺序加载 APlayer → MetingJS（MetingJS 依赖 APlayer）
    await loadScript('https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.js');
    await loadScript('https://cdn.jsdelivr.net/npm/meting@2/dist/Meting.min.js');

    // 将占位容器转换为 meting-js 元素
    const container = document.getElementById('meting-container');
    if (container) {
      const meting = document.createElement('meting-js');
      // 从 data-* 属性复制到 meting-js 属性
      const attrMap: Record<string, string> = {
        'data-id': 'id', 'data-server': 'server', 'data-type': 'type',
        'data-fixed': 'fixed', 'data-mini': 'mini', 'data-autoplay': 'autoplay',
        'data-theme': 'theme', 'data-loop': 'loop', 'data-order': 'order',
        'data-preload': 'preload', 'data-list-folded': 'list-folded',
        'data-list-max-height': 'list-max-height', 'data-lrc-type': 'lrc-type',
        'data-volume': 'volume'
      };
      for (const [dataAttr, metingAttr] of Object.entries(attrMap)) {
        const val = container.getAttribute(dataAttr);
        if (val) meting.setAttribute(metingAttr, val);
      }
      container.replaceWith(meting);
    }
  }

  const playerContainer = document.getElementById('music-player-container');
  const toggleBtn = document.getElementById('music-toggle');
  const closeBtn = document.getElementById('music-close');

  // 从 localStorage 恢复状态
  const savedState = localStorage.getItem('musicPanelOpen');
  if (savedState === 'true') {
    playerContainer?.classList.add('open');
    // 面板之前是打开的，静默加载播放器
    loadMusicPlayer();
  }

  async function togglePanel() {
    await loadMusicPlayer(); // 首次点击时加载
    const isOpen = playerContainer?.classList.toggle('open');
    localStorage.setItem('musicPanelOpen', isOpen ? 'true' : 'false');
  }

  toggleBtn?.addEventListener('click', togglePanel);
  closeBtn?.addEventListener('click', () => {
    playerContainer?.classList.remove('open');
    localStorage.setItem('musicPanelOpen', 'false');
  });
</script>

<style>
  /* Container positioning - same as previous design */
  .music-player-container {
    position: fixed;
    right: 0;
    bottom: 25%;
    z-index: 40;
    font-family: 'Inter', sans-serif;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  /* Toggle Button - Side Tab Style */
  .music-toggle {
    width: auto;
    height: auto;
    min-width: 80px;
    padding: 8px 12px 8px 16px; 
    border-radius: 8px 0 0 8px;
    background: #2d4a3e;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 1px solid rgba(0,0,0,0.05);
    border-right: none;
    box-shadow: -2px 4px 6px rgba(0,0,0,0.1);
    letter-spacing: 0.5px;
  }

  .music-toggle:hover {
    transform: translateX(-4px); 
    background: #36574a;
  }

  .music-player-container.open .music-toggle {
    background: #8a6240; 
  }

  /* Panel Styling */
  .music-panel {
    position: absolute;
    bottom: auto;
    top: 50px; 
    right: 10px;
    
    width: 340px; /* Slightly wider for APlayer */
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
    border-radius: 8px;
    padding: 12px;
    opacity: 0;
    transform: translateX(20px);
    pointer-events: none;
    transition: all 0.3s ease;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(0,0,0,0.05);
  }

  .music-player-container.open .music-panel {
    opacity: 1;
    transform: translateX(0);
    pointer-events: all;
  }

  .music-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    margin-bottom: 8px;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #4a4a4a;
  }

  .close-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.25rem;
    color: #999;
    padding: 0 4px;
    line-height: 1;
    transition: color 0.2s;
  }

  .close-btn:hover {
    color: #333;
  }

  /* Customize APlayer Styles to match Blog Theme */
  :global(.aplayer) {
    margin: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
    font-family: inherit !important;
  }

  :global(.aplayer .aplayer-body) {
    background-color: transparent !important;
  }

  :global(.aplayer .aplayer-info) {
    border-bottom: none !important;
  }

  :global(.aplayer .aplayer-info .aplayer-music .aplayer-title) {
    color: #1a1a1a !important;
    font-weight: 600;
  }
  
  :global(.aplayer .aplayer-list ol li) {
    border-top: 1px solid #eee !important;
  }
  
  :global(.aplayer .aplayer-list ol li:hover) {
    background: rgba(138, 98, 64, 0.05) !important;
  }
  
  :global(.aplayer .aplayer-list ol li.aplayer-list-light) {
    background: rgba(138, 98, 64, 0.1) !important;
  }

  /* Hide lyrics to save space if needed, or keep them */
  :global(.aplayer .aplayer-lrc) {
    display: none !important; /* Optional: hide lyrics */
  }

  @media (max-width: 768px) {
    .music-toggle {
        padding: 8px 10px 8px 12px;
    }
    .music-toggle .label {
        display: none; 
    }
    .music-panel {
        right: 5px;
        width: 300px;
    }
  }
</style>
