---
// SearchBox.astro - 搜索框组件（委托 FilterController 统一过滤）
// 支持多实例：桌面 Sidebar + 移动端 MobileNav 各一个
---

<div class="search-box mb-6" data-role="search-box">
  <div class="relative">
    <input 
      type="text" 
      data-role="search-input"
      placeholder="搜索文章、工具、视频..."
      class="w-full px-4 py-2.5 pl-10 bg-white border border-gray-300 rounded-sm text-sm font-body
             focus:border-ochre focus:ring-1 focus:ring-ochre focus:outline-none
             transition-colors placeholder:text-gray-400"
    />
    <!-- 搜索图标 -->
    <svg class="search-icon absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
    <!-- 清除按钮 -->
    <button 
      data-role="search-clear" 
      class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 text-lg leading-none"
      title="清除搜索"
    >&times;</button>
  </div>
  
  <!-- 搜索状态 -->
  <div data-role="search-status" class="hidden mt-2 text-xs text-gray-500 italic"></div>
</div>

<style>
  [data-role="search-input"]:focus ~ .search-icon {
    color: #8a6240; /* ochre */
  }
</style>
