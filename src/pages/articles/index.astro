---
// articles/index.astro - 文章列表页（编辑部档案风格）
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/TopNav.astro';
import Footer from '../../components/Footer.astro';
import { formatDateEN } from '../../utils/date';
import { countTags, mapArticleEntry, sortByDateDesc } from '../../utils/content';

const pageTitle = 'Articles - TechArt Chronicle';
const description = '技术美术文章合集 - Unreal Engine、Unity Shader、Houdini、GAMES 系列课程笔记等。';

const sortedArticles = sortByDateDesc(
  (await getCollection('articles')).filter((entry) => entry.data.listed !== false).map(mapArticleEntry)
);
const featuredArticles = sortedArticles.slice(0, 4);
const restArticles = sortedArticles.slice(4);
const filterTags = countTags(sortedArticles);

---

<BaseLayout title={pageTitle} description={description}>
  <TopNav currentSection="articles" subPage />

  <div class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
    <main class="space-y-12" data-filter-root>
        <section class="blur-load space-y-5" data-role="article-tag-filter">
          <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">筛选 Filter</p>
              <h2 class="mt-2 font-serif text-3xl text-ink">按标签筛选</h2>
              <p class="mt-2 max-w-2xl text-sm leading-7 text-gray-600">
                支持多标签共选，任一标签命中即可显示文章。
              </p>
            </div>
          </div>

          <div class="rounded-[1.5rem] border border-ink/10 bg-white/70 p-4 space-y-3">
            <div class="flex flex-wrap gap-2">
              <button class="tag-filter-btn active rounded-full border border-forest/20 bg-forest px-4 py-2 text-xs font-bold uppercase tracking-[0.3em] text-white transition-all" data-role="clear-filters">
                全部 ({sortedArticles.length})
              </button>
              {filterTags.map(({ tag, count }) => (
                <button
                  class="tag-filter-btn rounded-full border border-ink/10 bg-paper px-4 py-2 text-xs font-bold uppercase tracking-[0.3em] text-ink transition-all hover:-translate-y-0.5 hover:border-ochre hover:text-ochre"
                  data-tag={tag}
                >
                  {tag} ({count})
                </button>
              ))}
            </div>

            <div class="flex flex-wrap items-center gap-3 text-sm text-gray-600">
              <span data-role="filter-status" class="hidden"><span data-role="filter-count"></span></span>
              <button data-role="clear-filters" class="hidden text-ochre hover:underline">清空标签</button>
            </div>
          </div>
        </section>

        <section class="blur-load space-y-5" data-section="featured" id="featured">
          <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">精选内容 Featured</p>
              <h2 class="mt-2 font-serif text-3xl text-ink">最新且最值得先读的文章</h2>
            </div>
            <a href="/articles/" class="text-sm font-semibold text-gray-500 transition-colors hover:text-ochre">查看全部文章 →</a>
          </div>

          <div class="grid gap-6 lg:grid-cols-12">
            {featuredArticles[0] && (
              <a
                href={featuredArticles[0].href}
                class="article-card group lg:col-span-7 overflow-hidden rounded-[1.75rem] border border-ink/10 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-ochre hover:shadow-[0_18px_42px_rgba(138,98,64,0.14)]"
                data-tags={featuredArticles[0].tags.join(',')}
              >
                <div class="relative aspect-[16/10] overflow-hidden bg-forest">
                  {featuredArticles[0].image ? (
                    <img
                      loading="lazy"
                      decoding="async"
                      src={featuredArticles[0].image}
                      alt={featuredArticles[0].imageAlt ?? featuredArticles[0].title}
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.12),transparent_35%),linear-gradient(135deg,#2d4a3e,#1a1a1a)] px-8 text-center font-serif text-3xl text-paper">
                      {featuredArticles[0].category}
                    </div>
                  )}
                  <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-ink/80 to-transparent"></div>
                  <div class="absolute left-5 top-5 rounded-full bg-paper/90 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.3em] text-forest backdrop-blur">
                    Featured 01
                  </div>
                </div>
                <div class="p-6 md:p-7">
                  <div class="flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.3em]">
                    <span class="rounded-full bg-forest/10 px-2.5 py-1 text-forest">{featuredArticles[0].category}</span>
                    {featuredArticles[0].readTime && <span class="text-gray-400">{featuredArticles[0].readTime}</span>}
                    <span class="text-gray-300">•</span>
                    <span class="text-gray-400">{formatDateEN(featuredArticles[0].date)}</span>
                  </div>
                  <h3 class="mt-4 font-serif text-2xl leading-tight text-ink transition-colors group-hover:text-forest md:text-3xl">
                    {featuredArticles[0].title}
                  </h3>
                  <p class="mt-4 max-w-2xl text-sm leading-7 text-gray-600 md:text-base">
                    {featuredArticles[0].description}
                  </p>
                </div>
              </a>
            )}

            <div class="grid gap-6 lg:col-span-5 lg:h-full lg:grid-rows-3">
              {featuredArticles.slice(1, 4).map((article, index) => (
                <a
                  href={article.href}
                  class="article-card group block h-full overflow-hidden rounded-[1.5rem] border border-ink/10 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-ochre hover:shadow-[0_18px_42px_rgba(138,98,64,0.14)]"
                  data-tags={article.tags.join(',')}
                >
                  <div class="grid gap-0 md:grid-cols-[160px,1fr]">
                    <div class="aspect-[16/10] bg-forest md:aspect-auto">
                      {article.image ? (
                        <img
                          loading="lazy"
                          decoding="async"
                          src={article.image}
                          alt={article.imageAlt ?? article.title}
                          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                      ) : (
                        <div class="flex h-full w-full items-center justify-center bg-[linear-gradient(135deg,#2d4a3e,#8a6240)] font-serif text-2xl text-paper">
                          {String(index + 2).padStart(2, '0')}
                        </div>
                      )}
                    </div>
                    <div class="p-5">
                      <div class="flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.3em]">
                        <span class="rounded-full bg-ochre/10 px-2.5 py-1 text-ochre">{String(index + 2).padStart(2, '0')}</span>
                        <span class="rounded-full bg-gray-100 px-2.5 py-1 text-gray-600">{article.category}</span>
                        {article.readTime && <span class="text-gray-400">{article.readTime}</span>}
                      </div>
                      <h3 class="mt-3 font-serif text-xl leading-tight text-ink transition-colors group-hover:text-forest">
                        {article.title}
                      </h3>
                      <p class="mt-3 text-sm leading-6 text-gray-600 line-clamp-3">
                        {article.description}
                      </p>
                      <div class="mt-4 text-xs font-semibold uppercase tracking-[0.25em] text-gray-400">
                        {formatDateEN(article.date)}
                      </div>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>

        <section class="blur-load space-y-5" id="timeline" data-section="browse" data-blur-priority="eager">
          <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">浏览文章 Browse</p>
              <h2 class="mt-2 font-serif text-3xl text-ink">按双栏快速浏览其余文章</h2>
            </div>
          </div>

          <div class="grid gap-4 xl:grid-cols-2">
            {restArticles.map((article, index) => (
              <a
                href={article.href}
                class="article-card group grid gap-4 rounded-[1.35rem] border border-ink/10 bg-white/85 p-4 transition-all duration-300 hover:-translate-y-1 hover:border-ochre hover:shadow-[0_14px_32px_rgba(138,98,64,0.12)] md:grid-cols-[140px,minmax(0,1fr),auto] md:items-center md:p-5"
                data-tags={article.tags.join(',')}
              >
                <div class="overflow-hidden rounded-[1.15rem] border border-ink/10 bg-forest">
                  {article.image ? (
                    <img
                      loading="lazy"
                      decoding="async"
                      src={article.image}
                      alt={article.imageAlt ?? article.title}
                      class="h-40 w-full object-cover transition-transform duration-700 group-hover:scale-105 md:h-full"
                    />
                  ) : (
                    <div class="flex h-40 w-full items-center justify-center bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.12),transparent_35%),linear-gradient(135deg,#2d4a3e,#1a1a1a)] px-4 text-center font-serif text-2xl text-paper md:h-full">
                      {article.placeholder ?? article.category}
                    </div>
                  )}
                </div>

                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.25em]">
                    <span class="text-ochre">{String(index + 1).padStart(2, '0')}</span>
                    <span class="hidden h-4 w-px bg-gray-200 md:block"></span>
                    <span class="rounded-full bg-forest/10 px-2.5 py-1 text-forest">{article.category}</span>
                    {article.readTime && <span class="text-gray-400">{article.readTime}</span>}
                  </div>
                  <h3 class="mt-3 font-serif text-xl leading-tight text-ink transition-colors group-hover:text-forest">
                    {article.title}
                  </h3>
                  <p class="mt-2 text-sm leading-6 text-gray-600 line-clamp-2">
                    {article.description}
                  </p>
                </div>

                <div class="flex items-center justify-between gap-4 text-sm text-gray-400 md:min-w-36 md:flex-col md:items-end md:justify-center">
                  <span>{formatDateEN(article.date)}</span>
                  <span class="font-semibold text-ochre transition-transform duration-300 group-hover:translate-x-1 md:translate-x-0">
                    →
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>

        <div class="mt-20 border-t border-gray-300 pt-8 flex justify-between items-center text-sm font-serif italic text-gray-500">
          <span>共 {sortedArticles.length} 篇文章</span>
          <a href="#top" class="text-ochre hover:underline">Back to Top →</a>
        </div>
    </main>
  </div>

  <Footer />
</BaseLayout>

<style>
  .tag-filter-btn {
    cursor: pointer;
  }
  .tag-filter-btn.active {
    background-color: #2d4a3e;
    color: white;
    border-color: #2d4a3e;
  }
  .tag-filter-btn:not(.active):hover {
    transform: translateY(-1px);
  }
  .article-card.is-hidden {
    display: none;
  }
</style>
