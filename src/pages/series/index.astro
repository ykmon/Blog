---
// src/pages/series/index.astro - 系列总览页
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import UnifiedSidebar from '../../components/UnifiedSidebar.astro';
import Footer from '../../components/Footer.astro';
import { seriesList } from '../../data/series';

const pageTitle = 'Series - TechArt Chronicle';
const description = '系列笔记合集 - GAMES101 图形学、GAMES104 游戏引擎、InsideUE4 源码分析等系列文章。';
---

<BaseLayout title={pageTitle} description={description}>
  <Header title="Series" subPage />

  <div class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

      <!-- SIDEBAR -->
      <UnifiedSidebar currentSection="series" showSearch={false} showProfile={false} />

      <!-- MAIN CONTENT -->
      <main class="lg:col-span-9 relative pl-0 lg:pl-12">
        <div class="mb-12">
          <span class="text-ochre font-bold text-xs tracking-wider uppercase mb-2 block">Collections</span>
          <p class="text-gray-600 italic font-serif">
            系统化的学习笔记，从基础到进阶的完整旅程。
          </p>
        </div>

        <!-- 系列卡片 -->
        <div class="space-y-8">
          {seriesList.map((series) => (
            <article class="bg-white border border-gray-200 rounded-sm overflow-hidden hover:border-ochre hover:shadow-lg transition-all duration-300">
              <!-- 系列头部 -->
              <div class="p-6 border-b border-gray-100">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <div class="flex items-center gap-3 mb-2">
                      <span class="text-ochre font-bold text-xs tracking-wider uppercase">{series.category}</span>
                      <span class="text-gray-300">|</span>
                      <span class="text-xs text-gray-500">{series.articles.length} 篇</span>
                    </div>
                    <h2 class="font-serif text-2xl font-bold text-ink mb-2">{series.title}</h2>
                    <p class="text-xs text-gray-400 uppercase tracking-widest">{series.titleEn}</p>
                  </div>
                  <a 
                    href={`/articles/${series.id}/`}
                    class="flex-shrink-0 px-4 py-2 bg-forest text-white text-sm font-serif italic rounded-sm hover:bg-ochre transition-colors"
                  >
                    进入系列 →
                  </a>
                </div>
                <p class="text-gray-600 leading-relaxed mt-4">
                  {series.description}
                </p>
                <!-- 标签 -->
                <div class="flex gap-2 mt-4">
                  {series.tags.map((tag) => (
                    <span class="px-2 py-0.5 bg-gray-100 text-xs text-gray-600 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              
              <!-- 文章目录 -->
              <div class="p-6 bg-gray-50/50">
                <h3 class="font-serif text-sm font-bold text-gray-500 mb-4 uppercase tracking-wider">
                  目录
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                  {series.articles.map((article) => (
                    <a 
                      href={`/articles/${article.slug}/`}
                      class="group flex items-center gap-3 p-3 bg-white rounded-sm border border-gray-200 hover:border-ochre hover:shadow-sm transition-all"
                    >
                      <span class="text-xs font-bold text-ochre w-12 flex-shrink-0">
                        {article.chapter}
                      </span>
                      <span class="text-sm text-gray-700 group-hover:text-forest transition-colors line-clamp-1">
                        {article.title}
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- 底部导航 -->
        <div class="mt-20 border-t border-gray-300 pt-8 flex justify-between items-center text-sm font-serif italic text-gray-500">
          <span>{seriesList.length} 个系列</span>
          <a href="#top" class="text-ochre hover:underline">Back to Top ↑</a>
        </div>
      </main>
    </div>
  </div>

  <Footer />
</BaseLayout>
