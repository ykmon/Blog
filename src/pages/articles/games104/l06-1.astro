---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

const content = `                    <img src="/Articles/games104/l06-1/Untitled.png" alt="地形渲染">                    <h2>地形渲染</h2>                    <img src="/Articles/games104/l06-1/Untitled 1.png" alt="Heightmap">                    <img src="/Articles/games104/l06-1/Untitled 2.png" alt="地形网格">                    <img src="/Articles/games104/l06-1/Untitled 3.png" alt="LOD">                    <h2>GPU细分</h2>                    <img src="/Articles/games104/l06-1/GPU计算细分.gif" alt="GPU细分">                    <p class="img-caption">GPU计算细分</p>                    <h2>可交互地形</h2>                    <img src="/Articles/games104/l06-1/可交互雪地.gif" alt="可交互雪地">                    <p class="img-caption">可交互雪地</p>                    <img src="/Articles/games104/l06-1/Untitled 10.png" alt="Virtual Texture">                    <img src="/Articles/games104/l06-1/Untitled 11.png" alt="Terrain Material">                    <p>详细内容请参阅原始Markdown文档。</p>                `;
