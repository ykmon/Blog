---
// UnifiedSidebar.astro - 统一侧边栏组件
// 替代原有的 Sidebar.astro 和 SubPageSidebar.astro
import SearchBox from './SearchBox.astro';

export interface Props {
  currentSection?: 'home' | 'articles' | 'series' | 'tools' | 'videos' | 'about';
  showSearch?: boolean;
  showProfile?: boolean;
}

const { 
  currentSection = 'home',
  showSearch = true,
  showProfile = true
} = Astro.props;

const sections = [
  { id: 'home', num: '00', label: '首页', labelEn: 'Home', href: '/' },
  { id: 'articles', num: '01', label: '文章列表', labelEn: 'Articles', href: '/articles/' },
  { id: 'series', num: '02', label: '系列笔记', labelEn: 'Series', href: '/series/' },
  { id: 'tools', num: '03', label: '工具库', labelEn: 'Tools', href: '/tools/' },
  { id: 'videos', num: '04', label: '视频教程', labelEn: 'Videos', href: '/videos/' },
  { id: 'about', num: '05', label: '关于', labelEn: 'About', href: '/about/' },
];
---

<aside class="hidden lg:block lg:col-span-3 relative">
  <div class="sidebar-sticky space-y-8">
    <!-- Profile Widget -->
    {showProfile && (
      <div class="text-center p-6 border border-gray-200 bg-white/50 backdrop-blur-sm rounded-sm">
        <div class="w-24 h-24 mx-auto bg-gray-300 rounded-full mb-4 overflow-hidden">
          <img loading="lazy" decoding="async" src="/Resource/ykmon.jpg" alt="Avatar" width="96" height="96" class="object-cover w-full h-full">
        </div>
        <h3 class="font-serif text-xl font-bold mb-1">YKMON</h3>
        <p class="text-xs text-gray-500 uppercase tracking-widest mb-4">Technical Artist</p>
        <p class="text-sm text-gray-600 leading-relaxed font-light">
          致力自动化管线开发，非传统技术美术，从项目管理到技术落地。
        </p>
      </div>
    )}

    <!-- Search Box -->
    {showSearch && <SearchBox />}

    <!-- Navigation -->
    <nav class="space-y-4">
      <h4 class="font-serif text-lg border-b border-gray-300 pb-2 mb-4 italic">Sections</h4>
      {sections.map((section) => (
        <a
          href={section.href}
          class:list={[
            'block transition-colors group',
            currentSection === section.id ? 'text-ochre font-bold' : 'text-ink hover:text-ochre'
          ]}
        >
          <span class:list={[
            'text-xs font-bold mr-2',
            currentSection === section.id ? 'text-ochre' : 'text-gray-400 group-hover:text-ochre'
          ]}>{section.num}</span>
          {section.label} / {section.labelEn}
        </a>
      ))}
    </nav>
  </div>
</aside>
