---
interface Props {
	title?: string;
    section?: string;
}

const { title = "Archive", section = "TechArt Chronicle" } = Astro.props;
---
<header class="py-12 md:py-16 text-center border-b border-gray-300 relative bg-paper z-10">
    <div class="container mx-auto px-6">
        <a href="/" class="inline-block hover:opacity-80 transition-opacity">
            <div class="text-xs font-bold tracking-[0.3em] uppercase text-ochre mb-2 font-serif">{section}
            </div>
            <h1 class="font-serif text-3xl md:text-5xl font-bold tracking-tight text-ink">{title}</h1>
        </a>
    </div>
</header>
