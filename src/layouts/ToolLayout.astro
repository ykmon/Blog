---
// ToolLayout.astro - 工具页面布局模板
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import UnifiedSidebar from '../components/UnifiedSidebar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  category?: string;
  description?: string;
}

const { 
  title, 
  category = 'Houdini / Tool',
  description,
} = Astro.props;
---

<BaseLayout title={`${title} - TechArt Chronicle`} description={description}>
  <Header title={title} subPage subtitle={description} />

  <div class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <UnifiedSidebar currentSection="tools" showProfile={false} />

      <main class="lg:col-span-9 relative pl-0 lg:pl-12">
        <div class="mb-6 flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.3em]">
          <span class="rounded-full bg-forest/10 px-2.5 py-1 text-forest">{category}</span>
          <span class="text-gray-400">Procedural / Tool</span>
        </div>

        <article class="overflow-hidden rounded-[2rem] border border-ink/10 bg-white/80 shadow-[0_18px_48px_rgba(26,26,26,0.06)]">
          <div class="border-b border-ink/10 p-6 md:p-8">
            <p class="text-[11px] font-bold uppercase tracking-[0.35em] text-ochre">Tool / Reference</p>
            <h1 class="mt-4 font-serif text-4xl md:text-5xl leading-tight text-ink">{title}</h1>
            {description && (
              <p class="mt-4 max-w-3xl text-sm md:text-base leading-7 text-gray-600">
                {description}
              </p>
            )}
          </div>

          <div class="prose prose-lg prose-slate max-w-none p-6 md:p-8" data-content-body>
            <slot />
          </div>
        </article>

        <div class="mt-20 border-t border-gray-300 pt-8 flex justify-between items-center text-sm font-serif italic text-gray-500">
          <a href="/tools/" class="text-ochre hover:underline">← Back to Tools</a>
          <a href="#top" class="text-ochre hover:underline">Back to Top ↑</a>
        </div>
      </main>
    </div>
  </div>

  <Footer />
</BaseLayout>
