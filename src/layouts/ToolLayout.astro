---
import BaseLayout from './BaseLayout.astro';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  category?: string;
  description?: string;
}
const { title, category = 'Houdini / Tool', description } = Astro.props;
---

<BaseLayout title={`${title} - TechArt Chronicle`} description={description}>
  <TopNav currentSection="tools" />
  <main class="reading-width page-main">
    <header class="page-heading">
      <p class="mb-3 text-sm">{category}</p>
      <h1>{title}</h1>
      {description && <p>{description}</p>}
    </header>
    <article class="article-prose prose prose-lg prose-slate max-w-none" data-content-body><slot /></article>
    <div class="mt-16 flex justify-between border-t border-gray-100 pt-6 text-sm text-gray-500">
      <a href="/tools/" class="hover:underline">← 返回工具库</a>
      <a href="#top" class="hover:underline">返回顶部 ↑</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
