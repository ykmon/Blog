---
// inside-ue4/index.astro - InsideUE4 系列索引页
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import SeriesChapters from '../../../components/SeriesChapters.astro';

const articles = [
  { href: 'chapter01-actorcomponent', title: 'Chapter01 Actor和Component', desc: 'GamePlay架构基础：Actor与Component模型' },
  { href: 'chapter02-levelworld', title: 'Chapter02 Level和World', desc: '关卡管理：Level与World的组织结构' },
  { href: 'chapter03-worldcontext', title: 'Chapter03 WorldContext', desc: '世界上下文与游戏实例' },
  { href: 'chapter04-pawn', title: 'Chapter04 Pawn', desc: '玩家控制：Pawn与Controller' },
  { href: 'chapter05-controller', title: 'Chapter05 Controller', desc: '控制系统的核心：Controller的设计思想' },
  { href: 'chapter06-player-ai-controller', title: 'Chapter06 PlayerController和AIController', desc: '玩家控制器与AI控制器的职责划分' },
  { href: 'chapter07-gamemode-gamestate', title: 'Chapter07 GameMode和GameState', desc: '游戏规则与状态管理' },
  { href: 'chapter08-player', title: 'Chapter08 Player', desc: 'Player类在GamePlay架构中的作用' },
  { href: 'chapter09-gameinstance', title: 'Chapter09 GameInstance', desc: '全局游戏实例与跨关卡数据' },
  { href: 'chapter10-summary', title: 'Chapter10 总结', desc: 'UE4 GamePlay架构全景回顾' },
];
---

<ArticleLayout 
  title="InsideUE4 源码分析系列" 
  category="InsideUE4"
  categoryLink="/series/"
  showToc={false}
  description="深入 UE4 GamePlay 架构源码分析"
>
  <p class="mb-10 text-gray-600">InsideUE4 是对 UE4 Gameplay 架构的源码型阅读笔记，从 Actor/Component 到 World、GameMode 和 GameInstance 的组织方式逐章拆解。</p>
  <SeriesChapters basePath="/articles/inside-ue4" articles={articles} />
</ArticleLayout>
