---
// ArticleLayout.astro - 文章页面布局模板 (优化版)
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import UnifiedSidebar from '../components/UnifiedSidebar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { formatDateEN } from '../utils/date';

export interface Props {
  title: string;
  category: string;
  categoryLink?: string;
  date?: string;
  description?: string;
  image?: string;
  keywords?: string;
  tags?: string[];
  slug?: string;
}

const { 
  title, 
  category, 
  categoryLink = '/articles/',
  date,
  description,
  image,
  keywords,
  tags = [],
  slug = ''
} = Astro.props;

// 面包屑项
const breadcrumbItems = [
  { label: 'Articles', href: '/articles/' },
  { label: category, href: categoryLink },
  { label: title }
];
---

<BaseLayout title={`${title} - TechArt Chronicle`} description={description} image={image} keywords={keywords}>
  <Header title={title} subPage subtitle={description} />

  <div class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

      <UnifiedSidebar currentSection="articles" showProfile={false} />

      <!-- MAIN CONTENT -->
      <main class="lg:col-span-9 relative pl-0 lg:pl-12">
        <Breadcrumb items={breadcrumbItems} />

        <article class="overflow-hidden rounded-[2rem] border border-ink/10 bg-white/80 shadow-[0_18px_48px_rgba(26,26,26,0.06)]">
          <div class="border-b border-ink/10 p-6 md:p-8 lg:p-10">
            <div class="flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.3em]">
              <span class="rounded-full bg-forest/10 px-2.5 py-1 text-forest">{category}</span>
              {date && <span class="rounded-full bg-gray-100 px-2.5 py-1 text-gray-500">{formatDateEN(date)}</span>}
              {tags.length > 0 && <span class="text-gray-400">{tags.length} tags</span>}
            </div>
            <h1 class="mt-4 max-w-4xl font-serif text-4xl md:text-5xl leading-[0.96] text-ink">{title}</h1>
            {description && (
              <p class="mt-5 max-w-3xl text-sm md:text-base leading-7 text-gray-600">
                {description}
              </p>
            )}
          </div>

          {image && (
            <div class="border-b border-ink/10">
              <img
                loading="lazy"
                decoding="async"
                src={image}
                alt={title}
                class="h-full w-full object-cover"
              />
            </div>
          )}

          <div class="article-prose prose prose-lg prose-slate max-w-none p-6 md:p-8 lg:p-10">
            <slot />
          </div>
        </article>

        <!-- 相关文章推荐 -->
        {slug && tags.length > 0 && (
          <RelatedArticles 
            currentSlug={slug} 
            tags={tags} 
            category={category}
            limit={3}
          />
        )}

        <div class="mt-20 border-t border-gray-300 pt-8 flex justify-between items-center text-sm font-serif italic text-gray-500">
          <a href={categoryLink} class="text-ochre hover:underline">← Back to Articles</a>
          <a href="#top" class="text-ochre hover:underline">Back to Top ↑</a>
        </div>
      </main>
    </div>
  </div>

  <Footer />
</BaseLayout>
