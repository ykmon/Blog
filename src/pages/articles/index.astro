---
// articles/index.astro - 文章列表页
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const pageTitle = 'Articles - TechArt Chronicle';
const description = '技术美术文章合集 - Unreal Engine、Unity Shader、Houdini、GAMES 系列课程笔记等。';

// 文章数据
import { articles } from '../../data/content';
---

<BaseLayout title={pageTitle} description={description} canonical="https://ykmon.github.io/Blog/articles/">
  <!-- Header -->
  <header class="py-12 md:py-16 text-center border-b border-gray-300 relative bg-paper z-10">
    <div class="container mx-auto px-6">
      <a href="/" class="inline-block">
        <div class="text-xs font-bold tracking-[0.3em] uppercase text-ochre mb-2 font-serif">TechArt Chronicle</div>
        <h1 class="font-serif text-3xl md:text-5xl font-bold tracking-tight text-ink">Archive</h1>
      </a>
    </div>
  </header>

  <div class="container mx-auto px-4 md:px-6 py-12 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

      <!-- SIDEBAR -->
      <aside class="hidden lg:block lg:col-span-3 relative">
        <div class="sticky top-8 space-y-12">
          <nav class="space-y-4">
            <a href="/" class="block text-ink hover:text-ochre transition-colors group">
              <span class="text-xs font-bold text-gray-400 mr-2 group-hover:text-ochre">←</span> Back to Home
            </a>
            <div class="h-px bg-gray-300 my-4"></div>
            <h4 class="font-serif text-lg pb-2 mb-2 italic text-gray-400">Sections</h4>
            <a href="/articles/" class="block text-ochre font-bold transition-colors">Articles</a>
            <a href="/videos/" class="block text-ink hover:text-ochre transition-colors">Videos</a>
            <a href="/tools/" class="block text-ink hover:text-ochre transition-colors">Tools</a>
          </nav>
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <main class="lg:col-span-8 lg:col-start-5 relative">
        <div class="mb-12">
          <span class="text-ochre font-bold text-xs tracking-wider uppercase mb-2 block">All Posts</span>
          <p class="text-gray-600 italic font-serif">Exploring the intersection of technology and art.</p>
        </div>

        <div class="grid gap-8">
          {articles.map((article) => (
            <ArticleCard {...article} />
          ))}
        </div>

        <div class="mt-20 border-t border-gray-300 pt-8 flex justify-between items-center text-sm font-serif italic text-gray-500">
          <span>Page 1 of 1</span>
          <a href="#" class="text-ochre hover:underline">Back to Top ↑</a>
        </div>
      </main>
    </div>
  </div>

  <Footer />
</BaseLayout>
