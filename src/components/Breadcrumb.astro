---
// Breadcrumb.astro - 面包屑导航组件
export interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav class="mb-6 text-sm font-body" aria-label="Breadcrumb">
  <ol class="flex items-center flex-wrap gap-2 text-gray-500">
    <li>
      <a href="/" class="text-gray-500 hover:text-ochre transition-colors">首页</a>
    </li>
    {items.map((item, index) => (
      <>
        <li class="text-gray-300">/</li>
        <li>
          {item.href ? (
            <a href={item.href} class="text-gray-500 hover:text-ochre transition-colors">
              {item.label}
            </a>
          ) : (
            <span class="text-ink font-medium">{item.label}</span>
          )}
        </li>
      </>
    ))}
  </ol>
</nav>
