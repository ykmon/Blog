---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

const content = `                    <img src="/Articles/games104/l05/Untitled.png" alt="光和材质">                    <p>本节详细讲解游戏引擎中光照和材质系统的数学原理，包括BRDF、PBR材质模型、IBL环境光照等核心概念。</p>                    <h2>渲染方程</h2>                    <img src="/Articles/games104/l05/Untitled 1.png" alt="渲染方程">                    <img src="/Articles/games104/l05/Untitled 2.png" alt="BRDF">                    <h2>PBR材质</h2>                    <img src="/Articles/games104/l05/Untitled 3.png" alt="PBR">                    <img src="/Articles/games104/l05/Untitled 4.png" alt="Microfacet">                    <img src="/Articles/games104/l05/Untitled 5.png" alt="GGX">                    <h2>IBL环境光照</h2>                    <img src="/Articles/games104/l05/Untitled 23.png" alt="IBL">                    <img src="/Articles/games104/l05/Untitled 24.png" alt="Prefilter">                    <img src="/Articles/games104/l05/Untitled 25.png" alt="Split Sum">                    <h2>阴影</h2>                    <img src="/Articles/games104/l05/Untitled 41.png" alt="Shadow">                    <img src="/Articles/games104/l05/Untitled 42.png" alt="CSM">                    <img src="/Articles/games104/l05/Untitled 43.png" alt="PCF">                    <p>详细内容请参阅原始Markdown文档。</p>                `;
---

<ArticleLayout 
  title="渲染中光和材质的数学魔法" 
  category="games104"
  description="光照模型、PBR材质、着色器"
>
  <div set:html={content} />
</ArticleLayout>
